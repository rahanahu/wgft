{{ define "addrule" }}
<h2 style="margin-top:0">{{ T .Locale "addRuleTitle" }}</h2>
{{ if .Error }}<p class="danger-text">{{ .Error }}</p>{{ end }}
<form method="post" action="/ui/add-rule" class="rule-form" id="rule-form">
  <div class="flow" aria-hidden="true">
    <span class="flow-node">{{ T .Locale "flowClient" }}</span>
    <span class="flow-arrow">→</span>
    <span class="flow-node accent">VPS<b id="flow-listen">:{{ T .Locale "flowPortN" }}</b></span>
    <span class="flow-arrow">→</span>
    <span class="flow-node" id="flow-agent">{{ T .Locale "flowAgentN" }}</span>
    <span class="flow-arrow">→</span>
    <span class="flow-node" id="flow-target">{{ T .Locale "flowTargetN" }}</span>
  </div>

  <div class="field">
    <label for="f-agent">{{ T .Locale "fAgent" }}</label>
    <select id="f-agent" name="agent" required>
      {{ range .Agents }}<option value="{{ .Name }}">{{ .Name }} ({{ .Address }})</option>{{ else }}<option disabled>{{ T $.Locale "noAgentsOpt" }}</option>{{ end }}
    </select>
  </div>

  <div class="field">
    <label for="f-proto">{{ T .Locale "fProto" }}</label>
    <select id="f-proto" name="proto"><option value="tcp">TCP</option><option value="udp">UDP</option></select>
  </div>

  <div class="field">
    <label for="f-listen">{{ T .Locale "fListen" }}</label>
    <input id="f-listen" class="search" name="listen_port" required placeholder="25565" inputmode="numeric">
    <small class="field-help">{{ T .Locale "fListenHelp" }}</small>
  </div>

  <div class="field">
    <label for="f-target">{{ T .Locale "fDest" }}</label>
    <input id="f-target" class="search" name="target" required placeholder="192.168.1.20:25565">
    <small class="field-help">{{ T .Locale "fDestHelp" }}</small>
  </div>

  <div class="field">
    <label for="f-group">{{ T .Locale "fGroup" }}</label>
    <input id="f-group" class="search" name="group" placeholder="minecraft" list="group-list" maxlength="32">
    <datalist id="group-list">{{ range .Groups }}<option value="{{ . }}"></option>{{ end }}</datalist>
    <small class="field-help">{{ T .Locale "fGroupHelp" }}</small>
  </div>

  <div class="field">
    <label for="f-note">{{ T .Locale "fNote" }}</label>
    <input id="f-note" class="search" name="note" maxlength="120">
    <small class="field-help">{{ T .Locale "fNoteHelp" }}</small>
  </div>

  <label class="check"><input type="checkbox" name="disabled" value="1"> {{ T .Locale "fAddDisabled" }}</label>

  <details class="advanced">
    <summary>{{ T .Locale "fAdvanced" }}</summary>
    <div class="advanced-body">
      {{ if eq .Mode "userspace" }}
      {{/* userspace: server 自身がすべてのルールを中継するので kernel/proxy の選択に意味が無い(仕様 6.3 節)。
           PROXY protocol の有無だけを持ち、送信時は JS がこの状態を vps_mode(proxy/kernel)にも写す。 */}}
      <label class="check">
        <input type="checkbox" id="f-proxy-userspace" name="proxy_protocol" value="1"> {{ T .Locale "fProxyProtoUS" }}
      </label>
      <small class="field-help">{{ T .Locale "fProxyProtoUSH" }}</small>
      <input type="hidden" id="f-vps-mode-userspace" name="vps_mode" value="kernel">
      {{ else }}
      <label class="mode-opt">
        <span class="mode-head"><input type="radio" name="vps_mode" value="kernel" checked> {{ T .Locale "fModeKernel" }}</span>
        <small class="field-help">{{ T .Locale "fModeKernelH" }}</small>
      </label>
      <label class="mode-opt">
        <span class="mode-head"><input type="radio" name="vps_mode" value="proxy"> {{ T .Locale "fModeProxyL" }}</span>
        <small class="field-help">{{ T .Locale "fModeProxyH" }}</small>
      </label>
      <label class="check proxy-only" hidden><input type="checkbox" name="proxy_protocol" value="1"> {{ T .Locale "fProxyProto" }}</label>
      {{ end }}
      <label class="check"><input type="checkbox" name="force" value="1"> {{ T .Locale "fForceNew" }}</label>
    </div>
  </details>

  <div class="form-actions">
    <button class="btn primary" type="submit">{{ T .Locale "submitAddRule" }}</button>
    <a class="btn" href="/">{{ T .Locale "cancel" }}</a>
  </div>
</form>
{{ end }}

{{ define "addagent" }}
<h2 style="margin-top:0">{{ T .Locale "addAgentTitle" }}</h2>
{{ if .Error }}<p class="danger-text">{{ .Error }}</p>{{ end }}
{{ if .JoinString }}
  <div class="alert warning-alert" style="margin:0 0 14px">
    <div class="alert-icon">✓</div>
    <div class="alert-body">
      <strong>{{ printf (T .Locale "joinIssued") .ExpiresAt }}</strong>
      <p>{{ T .Locale "joinHelp" }}</p>
      <pre class="terminal" style="margin:0;white-space:pre-wrap;word-break:break-all">{{ .JoinString }}</pre>
    </div>
  </div>
  <a class="btn" href="/">{{ T .Locale "back" }}</a>
{{ else }}
  <form method="post" action="/ui/add-agent" style="display:grid;gap:12px;max-width:420px">
    <label>{{ T .Locale "fAgentName" }}<input class="search" name="name" required placeholder="home"></label>
    <div style="display:flex;gap:8px">
      <button class="btn primary" type="submit">{{ T .Locale "genJoin" }}</button>
      <a class="btn" href="/">{{ T .Locale "cancel" }}</a>
    </div>
  </form>
{{ end }}
{{ end }}

{{ define "checkresult" }}
<h2 style="margin-top:0">{{ T .Locale "checkTitle" }}</h2>
<p class="muted">{{ printf (T .Locale "checkRuleVia") .RuleLabel .Agent }}</p>
{{ if .OK }}
  <div class="alert warning-alert"><div class="alert-icon" style="color:var(--success)">✓</div><div class="alert-body"><strong class="success-text">{{ T .Locale "checkOK" }}</strong><p>{{ .Detail }}</p></div></div>
{{ else }}
  <div class="alert danger-alert"><div class="alert-icon">▲</div><div class="alert-body"><strong class="danger-text">{{ .ReachLabel }}</strong><p>{{ .Detail }}</p></div></div>
{{ end }}
<p class="muted" style="font-size:12px">{{ T .Locale "checkNote" }}</p>
<a class="btn" href="/">{{ T .Locale "back" }}</a>
{{ end }}

{{ define "ruledetail" }}
<p class="muted"><a href="/">{{ T .Locale "back" }}</a></p>
<div class="rule-detail-head">
  <div class="rule-summary">
    <strong class="proto {{ .ProtoClass }}">{{ .ProtoUpper }}</strong> <span class="mono">{{ .Ports }}</span>
    <span class="flow-arrow">→</span> {{ .Agent }} <span class="mono">{{ .Target }}</span>
    <span class="badge neutral">{{ .Mode }}</span>
    <span class="badge {{ .StateBadge }}">● {{ .StateLabel }}</span>
    <form method="post" action="/ui/rules/{{ .ID }}/{{ if .Enabled }}disable{{ else }}enable{{ end }}">
      <button class="small-btn" type="submit">{{ if .Enabled }}{{ T .Locale "disable" }}{{ else }}{{ T .Locale "enable" }}{{ end }}</button>
    </form>
    <a class="small-btn accent" href="/ui/doctor/{{ .ID }}">{{ T .Locale "doctorTitle" }}</a>
  </div>
  {{ if .StateReason }}<p class="danger-text">{{ .StateReason }}</p>{{ end }}
  {{ if .Note }}<p class="muted">{{ .Note }}</p>{{ end }}
</div>

<section class="detail-section">
  <h3>{{ T .Locale "metaHead" }}</h3>
  {{ if .MetaError }}<p class="danger-text">{{ .MetaError }}</p>{{ end }}
  <form method="post" action="/ui/rules/{{ .ID }}/meta" class="rule-form">
    <div class="field">
      <label for="e-group">{{ T .Locale "fGroup" }}</label>
      <input id="e-group" class="search" name="group" value="{{ .Group }}" list="group-list" maxlength="32" placeholder="minecraft">
      <datalist id="group-list">{{ range .Groups }}<option value="{{ . }}"></option>{{ end }}</datalist>
      <small class="field-help">{{ T .Locale "fGroupHelp" }}</small>
    </div>
    <div class="field">
      <label for="e-note">{{ T .Locale "fNote" }}</label>
      <input id="e-note" class="search" name="note" value="{{ .Note }}" maxlength="120">
      <small class="field-help">{{ T .Locale "fNoteHelp" }}</small>
    </div>
    <div class="form-actions"><button class="btn primary" type="submit">{{ T .Locale "save" }}</button></div>
  </form>
</section>

<section class="detail-section">
  <h3>{{ T .Locale "denyListHead" }}</h3>
  <p class="field-help">{{ T .Locale "denyListHelp" }}</p>
  {{ if .DenyError }}<p class="danger-text">{{ .DenyError }}</p>{{ end }}
  <ul class="cidr-list">
    {{ range .DenyList }}
    <li><span class="mono">{{ .CIDR }}</span>
      <form method="post" action="/ui/rules/{{ $.ID }}/deny/rm">
        <input type="hidden" name="cidr" value="{{ .CIDR }}">
        <button class="small-btn" type="submit">{{ T $.Locale "remove" }}</button>
      </form>
    </li>
    {{ else }}<li class="muted">{{ T $.Locale "listEmpty" }}</li>{{ end }}
  </ul>
  <form method="post" action="/ui/rules/{{ .ID }}/deny/add" class="inline-form">
    <div class="field">
      <textarea name="cidrs" rows="3" placeholder="203.0.113.7&#10;198.51.100.0/24">{{ .DenyInput }}</textarea>
      <small class="field-help">{{ T .Locale "addSourcesHelp" }}</small>
    </div>
    <button class="btn" type="submit">{{ T .Locale "add" }}</button>
  </form>
</section>

<section class="detail-section">
  <h3>{{ T .Locale "allowListHead" }}</h3>
  <p class="field-help">{{ T .Locale "allowListHelp" }}</p>
  {{ if .AllowError }}<p class="danger-text">{{ .AllowError }}</p>{{ end }}
  <ul class="cidr-list">
    {{ range .AllowList }}
    <li><span class="mono">{{ .CIDR }}</span>
      <form method="post" action="/ui/rules/{{ $.ID }}/allow/rm" {{ if .Confirm }}data-confirm="{{ T $.Locale "confirmAllowLast" }}"{{ end }}>
        <input type="hidden" name="cidr" value="{{ .CIDR }}">
        <button class="small-btn" type="submit">{{ T $.Locale "remove" }}</button>
      </form>
    </li>
    {{ else }}<li class="muted">{{ T $.Locale "listEmpty" }}</li>{{ end }}
  </ul>
  <form method="post" action="/ui/rules/{{ .ID }}/allow/add" class="inline-form" {{ if .AllowConfirmAdd }}data-confirm="{{ T .Locale "confirmAllowFirst" }}"{{ end }}>
    <div class="field">
      <textarea name="cidrs" rows="3" placeholder="203.0.113.7">{{ .AllowInput }}</textarea>
      <small class="field-help">{{ T .Locale "addSourcesHelp" }}</small>
    </div>
    <button class="btn" type="submit">{{ T .Locale "add" }}</button>
  </form>
</section>

<section class="detail-section">
  <div class="title-row"><h3>{{ T .Locale "rateHead" }}</h3><small class="muted">{{ printf (T .Locale "rateDroppedFmt") .Dropped }}</small></div>
  <p class="field-help">{{ T .Locale "rateHelp" }}</p>
  {{ if .RateError }}<p class="danger-text">{{ .RateError }}</p>{{ end }}
  {{ $loc := .Locale }}
  <form method="post" action="/ui/rules/{{ .ID }}/rates" class="rate-form">
    <div class="rate-field">
      <div class="rate-row">
        <span class="rate-label">{{ T .Locale "ratePerSourceHead" }}</span>
        <input type="number" min="1" name="per_source_count" value="{{ .Rates.PerSource.Count }}">
        <span class="rate-unit-word">{{ T .Locale "rateConnWord" }}</span> /
        <select name="per_source_unit">{{ range $u := .Units }}<option value="{{ $u }}" {{ if eq $u $.Rates.PerSource.Unit }}selected{{ end }}>{{ UnitLabel $loc $u }}</option>{{ end }}</select>
        <label class="check"><input type="checkbox" name="per_source_nolimit" value="1" {{ if .Rates.PerSource.NoLimit }}checked{{ end }}> {{ T .Locale "noLimit" }}</label>
      </div>
      <p class="field-help">{{ T .Locale "ratePerSourceHelp" }}</p>
      {{ if and (not .Rates.PerSource.NoLimit) .Rates.PerSource.Count }}<p class="rate-summary">{{ printf (T .Locale "rateSummaryPerSourceFmt") (UnitLabel $loc .Rates.PerSource.Unit) .Rates.PerSource.Count }}</p>{{ end }}
    </div>

    <div class="rate-field">
      <div class="rate-row">
        <span class="rate-label">{{ T .Locale "rateNewFlowHead" }}</span>
        <input type="number" min="1" name="new_flow_count" value="{{ .Rates.NewFlow.Count }}">
        <span class="rate-unit-word">{{ T .Locale "rateConnWord" }}</span> /
        <select name="new_flow_unit">{{ range $u := .Units }}<option value="{{ $u }}" {{ if eq $u $.Rates.NewFlow.Unit }}selected{{ end }}>{{ UnitLabel $loc $u }}</option>{{ end }}</select>
        <label class="check"><input type="checkbox" name="new_flow_nolimit" value="1" {{ if .Rates.NewFlow.NoLimit }}checked{{ end }}> {{ T .Locale "noLimit" }}</label>
      </div>
      <p class="field-help">{{ T .Locale "rateNewFlowHelp" }}</p>
      {{ if and (not .Rates.NewFlow.NoLimit) .Rates.NewFlow.Count }}<p class="rate-summary">{{ printf (T .Locale "rateSummaryWholeFmt") (UnitLabel $loc .Rates.NewFlow.Unit) .Rates.NewFlow.Count }}</p>{{ end }}
    </div>

    {{ $hasPacket := and (not .Rates.Packet.NoLimit) .Rates.Packet.Count }}
    <details class="advanced" {{ if $hasPacket }}open{{ end }}>
      <summary>{{ T .Locale "ratePacketDetails" }}</summary>
      <div class="advanced-body">
        <div class="rate-field">
          <div class="rate-row">
            <span class="rate-label">{{ T .Locale "ratePacketHead" }}</span>
            <input type="number" min="1" name="packet_count" value="{{ .Rates.Packet.Count }}">
            <span class="rate-unit-word">{{ T .Locale "ratePacketWord" }}</span> /
            <select name="packet_unit">{{ range $u := .Units }}<option value="{{ $u }}" {{ if eq $u $.Rates.Packet.Unit }}selected{{ end }}>{{ UnitLabel $loc $u }}</option>{{ end }}</select>
            <label class="check"><input type="checkbox" name="packet_nolimit" value="1" {{ if .Rates.Packet.NoLimit }}checked{{ end }}> {{ T .Locale "noLimit" }}</label>
          </div>
          <p class="field-help">{{ T .Locale "ratePacketHelp" }}</p>
          {{ if $hasPacket }}<p class="rate-summary">{{ printf (T .Locale "rateSummaryPacketFmt") (UnitLabel $loc .Rates.Packet.Unit) .Rates.Packet.Count }}</p>{{ end }}
          {{ if .ShowPacketNote }}<p class="field-help">{{ T .Locale "packetTCPNoEffectNote" }}</p>{{ end }}
        </div>
      </div>
    </details>

    <div class="form-actions"><button class="btn primary" type="submit">{{ T .Locale "save" }}</button></div>
  </form>
</section>

{{ if .CanSplit }}
<section class="detail-section">
  <h3>{{ T .Locale "splitHead" }}</h3>
  <p class="field-help">{{ T .Locale "splitHelp" }}</p>
  {{ if .SplitError }}<p class="danger-text">{{ .SplitError }}</p>{{ end }}
  <form method="post" action="/ui/rules/{{ .ID }}/split" class="split-form" id="split-form"
        data-listen-lo="{{ .ListenLo }}" data-listen-hi="{{ .ListenHi }}"
        data-target-host="{{ .TargetHost }}" data-target-port="{{ .TargetPort }}">
    <div class="field">
      <label for="split-at">{{ T .Locale "splitAt" }}</label>
      <select id="split-at" name="at">
        {{ range .SplitPorts }}<option value="{{ . }}">{{ . }}</option>{{ end }}
      </select>
    </div>
    <p id="split-preview" class="mono split-preview"></p>
    <div class="form-actions"><button class="btn primary" type="submit">{{ T .Locale "splitSubmit" }}</button></div>
  </form>
</section>
{{ end }}

<section class="detail-section">
  <h3>{{ T .Locale "mergeHead" }}</h3>
  <p class="field-help">{{ T .Locale "mergeHelp" }}</p>
  {{ if .MergeError }}<p class="danger-text">{{ .MergeError }}</p>{{ end }}
  {{ if .MergeCandidates }}
  <ul class="merge-list">
    {{ range .MergeCandidates }}
    <li>
      <span><strong class="proto {{ $.ProtoClass }}">{{ $.ProtoUpper }}</strong> <span class="mono">{{ .Ports }}</span>
        <span class="flow-arrow">→</span> <span class="mono">{{ .Target }}</span></span>
      <form method="post" action="/ui/rules/{{ $.ID }}/merge">
        <input type="hidden" name="other" value="{{ .ID }}">
        <button class="btn" type="submit">{{ T $.Locale "mergeWithThis" }}</button>
      </form>
    </li>
    {{ end }}
  </ul>
  {{ else if .MergeBlocked }}
  <p class="muted">{{ printf (T .Locale "mergeBlockedFmt") .MergeBlocked.Ports .MergeBlocked.Target .MergeBlocked.Reason }}</p>
  {{ else }}
  <p class="muted">{{ T .Locale "mergeNoNeighbor" }}</p>
  {{ end }}
</section>
{{ end }}
