{{ define "doctorcheck" }}
<li class="check-row">
  <div class="check-head">
    <span class="check-label">{{ .Label }}</span>
    <span class="badge {{ .Badge }}">{{ .Status }}</span>
  </div>
  {{ if .Detail }}<p class="check-detail">{{ .Detail }}</p>{{ end }}
  {{ if .Causes }}<ul class="check-causes">{{ range .Causes }}<li>{{ . }}</li>{{ end }}</ul>{{ end }}
  {{ if .Next }}<p class="check-next"><strong>Check:</strong> {{ .Next }}</p>{{ end }}
  {{ if .ScreenNote }}<p class="field-help" style="margin-top:6px">{{ .ScreenNote }}</p>{{ end }}
  {{ if .Internal }}<details class="check-internal"><summary>{{ T .Locale "doctorInternalHead" }}</summary><ul>{{ range .Internal }}<li class="mono">{{ . }}</li>{{ end }}</ul></details>{{ end }}
</li>
{{ end }}

{{ define "doctorpathmini" }}
<ol class="path mini" aria-label="{{ .Aria }}">
  {{ range .Nodes }}<li class="node {{ .State }}{{ if .AfterStop }} after-stop{{ end }}" title="{{ .Alt }}"><span class="node-mark" aria-hidden="true">{{ .Symbol }}</span><span class="sr-only">{{ .Alt }}</span></li>{{ end }}
</ol>
{{ end }}

{{ define "doctorpathfull" }}
<ol class="path full" aria-label="{{ .Aria }}">
  {{ range .Nodes }}
  <li class="node {{ .State }}{{ if .AfterStop }} after-stop{{ end }}" title="{{ .Alt }}">
    <span class="node-mark" aria-hidden="true">{{ .Symbol }}</span>
    <span class="node-text" aria-hidden="true">
      <span class="node-name">{{ .Name }}</span>
      <span class="node-word">{{ .Word }}</span>
      {{ if .Stop }}<span class="node-stop mono">{{ .Stop }}</span>{{ end }}
      {{ if .Note }}<span class="node-note">{{ .Note }}</span>{{ end }}
    </span>
    <span class="sr-only">{{ .Alt }}{{ if .Stop }}. {{ .Stop }}{{ end }}</span>
  </li>
  {{ end }}
</ol>
{{ end }}

{{ define "doctortail" }}
<section class="detail-section">
  <h3>{{ T .Locale "doctorHistoryHead" }}</h3>
  <p class="check-detail"><span class="badge neutral">NOT AVAILABLE</span> {{ .History }}</p>
</section>

<section class="detail-section">
  <h3>{{ T .Locale "doctorNotTestedHead" }}</h3>
  <ul class="check-list">
    {{ range .NotTested }}
    <li class="check-row"><div class="check-head"><span class="check-label">{{ .ID }}</span></div><p class="check-detail">{{ .Detail }}</p></li>
    {{ end }}
  </ul>
</section>
<p class="muted" style="font-size:12px">{{ T .Locale "doctorCheckedAt" }} {{ .CheckedAt }}</p>
{{ end }}

{{ define "doctorsummary" }}
<h2 style="margin-top:0">{{ T .Locale "doctorTitle" }}</h2>
<p class="field-help">{{ T .Locale "doctorIntro" }}</p>

<section class="detail-section">
  <h3>Server</h3>
  <ul class="check-list">{{ template "doctorcheck" .Server }}</ul>
</section>

<section class="detail-section">
  <h3>Agents</h3>
  {{ if .Agents }}
  <div class="table-scroll">
    <table class="data-table doctor-table">
      <thead>
        <tr><th>{{ T .Locale "colAgent" }}</th><th class="path-head">tunnel - stream - rules</th><th>{{ T .Locale "doctorFinding" }}</th></tr>
      </thead>
      <tbody>
        {{ range .Agents }}
        <tr>
          <td data-label="{{ T $.Locale "colAgent" }}"><span class="check-label">{{ .Name }}</span> <span class="badge {{ .Badge }}">{{ .Status }}</span></td>
          <td data-label="tunnel - stream - rules">{{ template "doctorpathmini" .Path }}</td>
          <td data-label="{{ T $.Locale "doctorFinding" }}" class="check-detail">{{ .Detail }}
            {{ if .Checks }}<details class="row-finding agent-finding"{{ if .Open }} open{{ end }}><summary>{{ T $.Locale "doctorAgentChecks" }}</summary><ul class="check-list">{{ range .Checks }}{{ template "doctorcheck" . }}{{ end }}</ul></details>{{ end }}
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  {{ else }}
  <p class="check-detail muted">no agent is named by any rule</p>
  {{ end }}
</section>

<section class="detail-section">
  <h3>Rules</h3>
  {{ $loc := .Locale }}
  <div class="table-scroll">
    <table class="data-table doctor-table">
      <thead>
        <tr>
          <th>{{ T $loc "colState" }}</th><th>{{ T $loc "doctorRuleCol" }}</th>
          <th class="path-head">public port - WireGuard - agent - listener / target</th>
        </tr>
      </thead>
      <tbody>
        {{ range .Rules }}
        <tr>
          <td data-label="{{ T $loc "colState" }}"><span class="badge {{ .Badge }}">{{ .Status }}</span></td>
          <td data-label="{{ T $loc "doctorRuleCol" }}">
            <a class="rule-link" href="/ui/doctor/{{ .ID }}"><strong class="proto {{ .ProtoClass }}">{{ .ProtoUpper }}</strong> {{ .Ports }} <span class="flow-arrow">→</span> {{ .Agent }} <span class="mono">{{ .Target }}</span></a>
            {{ if .Why }}<details class="row-finding"><summary>{{ T $loc "doctorFindingMore" }}</summary><p class="check-detail">{{ .Why }}</p></details>{{ end }}
          </td>
          <td data-label="public port - WireGuard - agent - listener / target">
            <a class="path-link" href="/ui/doctor/{{ .ID }}">{{ template "doctorpathmini" .Path }}{{ if .Path.Caption }}<span class="path-caption mono">{{ .Path.Caption }}</span>{{ end }}</a>
          </td>
        </tr>
        {{ else }}
        <tr><td colspan="3" class="muted">{{ T $loc "noRules" }}</td></tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  <p class="doctor-result"><strong>Result:</strong> {{ .Result }}</p>
  <p class="field-help">{{ T $loc "doctorProbeOnRulePage" }}</p>
</section>

{{ template "doctortail" . }}
{{ end }}

{{ define "doctorrule" }}
<p class="muted"><a href="/ui/doctor">{{ T .Locale "doctorBackToSummary" }}</a></p>
{{ with .Rule }}
<div class="rule-detail-head">
  <div class="rule-summary">
    <strong class="proto {{ .ProtoClass }}">{{ .ProtoUpper }}</strong> <span class="mono">{{ .Ports }}</span>
    <span class="flow-arrow">→</span> {{ .Agent }} <span class="mono">{{ .Target }}</span>
    <span class="badge {{ .Badge }}">{{ .Status }}</span>
    {{ if .Group }}<span class="badge neutral">{{ .Group }}</span>{{ end }}
  </div>
  <p class="muted mono" style="font-size:12px">{{ .ID }}</p>
</div>
{{ end }}

{{ with .Banner }}
<div class="doctor-banner {{ .Badge }}" role="note">
  <span class="check-label">dataplane</span> <span class="badge {{ .Badge }}">{{ .Status }}</span>
  <span>{{ T $.Locale "doctorBanner" }}</span>
  {{ if .Detail }}<p class="check-detail">{{ .Detail }}</p>{{ end }}
</div>
{{ end }}

{{ with .Rule }}
<section class="detail-section path-section">
  {{ template "doctorpathfull" .Path }}
</section>
{{ end }}

<p class="doctor-result"><strong>Result:</strong> {{ .Result }}</p>

{{ with .Rule }}
<section class="detail-section">
  {{ range .Path.Nodes }}{{ if .Rows }}
  <details class="node-detail"{{ if .Open }} open{{ end }}>
    <summary>
      <span class="node {{ .State }} node-inline"><span class="node-mark" aria-hidden="true">{{ .Symbol }}</span></span>
      <strong>{{ .Name }}</strong> <span class="badge {{ .Badge }}">{{ .Word }}</span>
      <span class="muted node-labels">{{ .LabelsText }}</span>
    </summary>
    <ul class="check-list">{{ range .Rows }}{{ template "doctorcheck" . }}{{ end }}</ul>
  </details>
  {{ end }}{{ end }}
</section>
{{ end }}

{{ if .OffPath }}
<section class="detail-section">
  <details class="node-detail"{{ if .Banner }} open{{ end }}>
    <summary><strong>{{ T .Locale "doctorOffPathHead" }}</strong></summary>
    <ul class="check-list">{{ range .OffPath }}{{ template "doctorcheck" . }}{{ end }}</ul>
  </details>
</section>
{{ end }}

<section class="detail-section">
  <h3>{{ T .Locale "doctorProbeHead" }}</h3>
  {{ if .CanProbe }}
  <form method="get" action="/ui/doctor/{{ .Rule.ID }}">
    <input type="hidden" name="probe" value="1">
    <button class="small-btn accent" type="submit">{{ T .Locale "doctorProbe" }}</button>
  </form>
  <p class="field-help">{{ T .Locale "doctorProbeHelp" }}</p>
  {{ else }}
  <p class="field-help">{{ T .Locale "doctorProbeUnavailable" }}</p>
  {{ end }}
</section>

{{ if .Hidden }}
<section class="detail-section">
  <details class="advanced">
    <summary>{{ T .Locale "doctorHiddenHead" }}</summary>
    <ul class="check-list advanced-body">{{ range .Hidden }}{{ template "doctorcheck" . }}{{ end }}</ul>
  </details>
</section>
{{ end }}

{{ template "doctortail" . }}
{{ end }}
