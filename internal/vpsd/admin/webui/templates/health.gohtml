{{ define "health" }}
<span class="status-dot {{ if not .Health.OK }}offline{{ end }}"></span>
<div>
  <strong>{{ .Health.Title }}</strong>
  <small>{{ .Health.Summary }}</small>
</div>
{{ if .Warnings }}<a class="badge danger warn-jump" href="#warnings">▲ {{ printf (T .Locale "warnLinkFmt") (len .Warnings) }}</a>{{ end }}
{{ end }}
