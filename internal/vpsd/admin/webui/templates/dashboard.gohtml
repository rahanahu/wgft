{{ define "dashboard" }}<!doctype html>
<html lang="{{ .Locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>wgft</title>
  <link rel="stylesheet" href="/static/styles.css">
  <script defer src="/static/app.js"></script>
</head>
<body>
  <div class="app-shell">
    <header class="topbar">
      <div class="brand-wrap">
        <div class="brand">wgft</div>
        <div class="subtitle">{{ T .Locale "subtitle" }}</div>
      </div>
      <div class="top-actions">
        <div class="global-health {{ .Health.Class }}" id="health" data-refresh="/ui/health">{{ template "health" . }}</div>
        <a class="btn" href="/ui/doctor">{{ T .Locale "doctorTitle" }}</a>
        <a class="btn primary" href="/ui/add-agent">{{ T .Locale "addAgent" }}</a>
        <a class="btn primary" href="/ui/add-rule">{{ T .Locale "addRule" }}</a>
        <span class="lang-switch">
          <a class="lang {{ if ne .Locale "en" }}active{{ end }}" href="?lang=ja">JA</a>
          <a class="lang {{ if eq .Locale "en" }}active{{ end }}" href="?lang=en">EN</a>
        </span>
      </div>
    </header>

    <main class="dashboard-stack">
      <section class="panel server-panel">
        <div class="section-head compact"><h2>{{ T .Locale "serverHead" }}</h2></div>
        <div class="server-strip">
          <div class="sv"><span class="sv-k">{{ T .Locale "svMode" }}</span><span class="sv-v mono">{{ .Server.Mode }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svEndpoint" }}</span><span class="sv-v mono">{{ .Server.Endpoint }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svWG" }}</span><span class="sv-v mono">{{ .Server.WG }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svAgentAPI" }}</span><span class="sv-v mono">{{ .Server.AgentAPI }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svMTU" }}</span><span class="sv-v mono">{{ .Server.MTU }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svIPForward" }}</span><span class="sv-v">{{ .Server.IPForward }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svConntrack" }}</span><span class="sv-v mono">{{ .Server.Conntrack }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svKernel" }}</span><span class="sv-v mono">{{ .Server.Kernel }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svNFT" }}</span><span class="sv-v mono">{{ .Server.NFT }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svVersion" }}</span><span class="sv-v mono">{{ .Server.Version }}</span></div>
          <div class="sv"><span class="sv-k">{{ T .Locale "svUptime" }}</span><span class="sv-v">{{ .Server.Uptime }}</span></div>
        </div>
      </section>

      <div id="warnings" data-refresh="/ui/warnings">{{ template "warnings" . }}</div>

      <section class="panel" id="agents" data-refresh="/ui/agents">
        {{ template "agents" . }}
      </section>
      <section class="panel" id="rules" data-refresh="/ui/rules">
        {{ template "rules" . }}
      </section>

      <section class="panel firewall-panel">
        <details class="firewall-details">
          <summary class="section-head compact"><h2>{{ T .Locale "firewall" }}</h2></summary>
          <pre class="terminal terminal-wide">{{ .FirewallText }}</pre>
        </details>
      </section>
    </main>

    <footer class="footer">wgft · {{ T .Locale "subtitle" }}</footer>
  </div>
</body>
</html>{{ end }}
