{{ define "warnings" }}
{{ if .Warnings }}
<section class="panel warnings-banner">
  <div class="section-head compact">
    <div class="title-row"><h2>{{ T .Locale "warningsHead" }}</h2><span class="count danger">{{ len .Warnings }}</span></div>
  </div>
  {{ $loc := .Locale }}
  {{ range .Warnings }}
  <article class="alert {{ .AlertClass }}">
    <div class="alert-icon">▲</div>
    <div class="alert-body">
      <div class="alert-head"><strong>{{ .Title }}</strong><small>{{ .Ago }}</small></div>
      <span class="tag">{{ .Agent }}</span>
      <p>{{ .Body }}</p>
      {{ if .Detail }}<div class="mono compare">{{ .Detail }}</div>{{ end }}
      <div class="alert-actions">
        <form autocomplete="off" method="post" action="/ui/agents/{{ .Agent }}/dismiss-warning" style="display:inline"><input type="hidden" name="kind" value="{{ .Kind }}"><input type="hidden" name="detail" value="{{ .Detail }}"><button class="btn" type="submit">{{ T $loc "dismiss" }}</button></form>
        <form autocomplete="off" method="post" action="/ui/agents/{{ .Agent }}/revoke" style="display:inline" data-confirm="{{ printf (T $loc "confirmRevoke") .Agent }}"><button class="btn danger-outline" type="submit">{{ T $loc "revokeAgent" }}</button></form>
      </div>
    </div>
  </article>
  {{ end }}
</section>
{{ else }}
{{/* 警告 0 件のときは何も表示せず、body の幅を取らない(ヘッダの全体ヘルスに件数が出る。
     10.1 節)。スクリーンリーダー向けにだけ状態を残す。 */}}
<p class="sr-only">{{ T .Locale "noWarnings" }}</p>
{{ end }}
{{ end }}
