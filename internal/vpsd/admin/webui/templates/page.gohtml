{{ define "page" }}<!doctype html>
<html lang="{{ .Locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>wgft · {{ .Title }}</title>
  <link rel="stylesheet" href="/static/styles.css">
  <script defer src="/static/app.js"></script>
</head>
<body>
  <div class="app-shell">
    {{- /* ヘッダと本文の枠は同じ最大幅を持つ。戻るボタンが本文の枠の右端にそろう */ -}}
    {{ $w := 640 }}{{ if .MaxWidth }}{{ $w = .MaxWidth }}{{ else if .Wide }}{{ $w = 900 }}{{ end }}
    <div class="page-frame" style="max-width:{{ $w }}px">
      <header class="topbar">
        <div class="brand-wrap"><div class="brand">wgft</div><div class="subtitle">{{ .Title }}</div></div>
        {{ if not .Crumbs }}<div class="top-actions"><a class="btn" href="/">{{ T .Locale "back" }}</a></div>{{ end }}
      </header>
      {{ with .Crumbs }}<nav class="crumbs" aria-label="{{ T $.Locale "crumbNav" }}"><ol>
        {{- range . }}<li>{{ if .Href }}<a href="{{ .Href }}">{{ .Label }}</a>{{ else }}<span aria-current="page">{{ .Label }}</span>{{ end }}</li>{{ end -}}
      </ol></nav>{{ end }}
      <main>
        <section class="panel" style="padding:18px">
          {{ .Body }}
        </section>
      </main>
    </div>
  </div>
</body>
</html>{{ end }}
