{{ define "brand" }}<div class="brand-wrap"><div class="brand">wgft</div><div class="subtitle">{{ . }}</div></div>{{ end }}

{{- /* 言語の切り替え。リンクは問い合わせ文字列だけの相対 URL なので、同じパスに留まり、それまでの
     問い合わせ文字列(probe=1 など)は引き継がない。言語はクッキーに残る(resolveLocale) */ -}}
{{ define "langswitch" }}<span class="lang-switch">
          <a class="lang {{ if ne . "en" }}active{{ end }}" href="?lang=ja">JA</a>
          <a class="lang {{ if eq . "en" }}active{{ end }}" href="?lang=en">EN</a>
        </span>{{ end }}

{{ define "page" }}<!doctype html>
<html lang="{{ .Locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>wgft · {{ .Title }}</title>
  <link rel="stylesheet" href="/static/styles.css">
  <script defer src="/static/app.js"></script>
</head>
<body>
  <div class="app-shell">
    {{- /* ヘッダはダッシュボードと同じ位置と大きさで描き、ロゴがどのページでも同じ場所に来る。
         ページごとに幅が変わるのは、パンくずと本文の枠だけで、左端はロゴにそろう(設計文書 10.1 節) */}}
    <header class="topbar">
      {{ template "brand" .Title }}
      <div class="top-actions">{{ template "langswitch" .Locale }}</div>
    </header>
    {{ $w := 640 }}{{ if .MaxWidth }}{{ $w = .MaxWidth }}{{ else if .Wide }}{{ $w = 900 }}{{ end }}
    <div class="page-frame" style="max-width:{{ $w }}px">
      {{ with .Crumbs }}<nav class="crumbs" aria-label="{{ T $.Locale "crumbNav" }}"><ol>
        {{- range . }}<li>{{ if .Href }}<a href="{{ .Href }}">{{ .Label }}</a>{{ else }}<span aria-current="page">{{ .Label }}</span>{{ end }}</li>{{ end -}}
      </ol></nav>{{ end }}
      <main>
        <section class="panel" style="padding:18px">
          {{ .Body }}
        </section>
      </main>
    </div>
  </div>
</body>
</html>{{ end }}
