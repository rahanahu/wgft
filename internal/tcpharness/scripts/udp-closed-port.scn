# Datagrams to a port without a socket and to one whose socket has closed. Linux and wgstack.md
# answer with Port Unreachable (ICMP type 3, code 3).
scenario udp-closed-port
refs: RFC 1122 4.1.3.1; wgstack.md, UDP receive

let src = addrport(PEER_ADDR, 41005)

let dst = addrport(DUT_ADDR, 5305)
inject_ip udp(src, dst, 501, pattern(64, 0x91))
await_ip 1s match=(to_peer(s) && s.proto == 1 && icmp_type(s) == 3) -> p
let m = parse_icmp(p)
let q = parse_quote(m.body)
let quoted = q.ok && q.id == 501 && q.src == PEER_ADDR && q.dst == DUT_ADDR && q.proto == 17 && len(q.payload) >= 8 && q.payload[:4] == udp(src, dst, 0, "").payload[:4]
check port-unreachable p.ok && m.code == 3 && quoted
  what: a datagram to a port without a socket draws Port Unreachable quoting it
  got: {yes_no(p.ok, "code " + text(m.code) + ", quote matches " + text(quoted), "no Port Unreachable")}
if p.ok
  measure port-unreachable-quote-bytes q.bytes
end

listen_udp c 5306
close c
let dst = addrport(DUT_ADDR, 5306)
inject_ip udp(src, dst, 502, pattern(64, 0x91))
await_ip 1s match=(to_peer(s) && s.proto == 1 && icmp_type(s) == 3) -> p
let m = parse_icmp(p)
let q = parse_quote(m.body)
let quoted = q.ok && q.id == 502 && q.src == PEER_ADDR && q.dst == DUT_ADDR && q.proto == 17 && len(q.payload) >= 8 && q.payload[:4] == udp(src, dst, 0, "").payload[:4]
check after-close p.ok && m.code == 3 && quoted
  what: a datagram to a closed socket's port draws Port Unreachable
  got: {yes_no(p.ok, "code " + text(m.code) + ", quote matches " + text(quoted), "no Port Unreachable")}
if p.ok
  measure after-close-quote-bytes q.bytes
end
