[Unit]
Description=wgft agent (home side, user-space WireGuard)
Documentation=https://github.com/rahanahu/wgft#readme
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
# Settings come from /etc/wgft/agent.env (WGFT_JOIN for the first start); the binary reads it.
# WGFT_AGENT_ALLOW_TARGETS in the same file restricts the LAN addresses the agent connects to, for
# example WGFT_AGENT_ALLOW_TARGETS=192.168.1.20:25565 (SECURITY.md); unset means no restriction.
ExecStart=/usr/local/bin/wgft agent run
Restart=on-failure
RestartSec=2
# A failure a restart cannot fix exits with code 3, names its category and says how to fix it: an
# agent.env that exists but cannot be read (a root-owned file without group read permission, for
# example root:wgft mode 0600), a syntax error in it, an invalid value, a missing join string on a
# first start (config), a join string the server rejects as spent or bound to a name already
# registered (conflict). A VPS that is unreachable, or answers 429 or 5xx, exits 1 and is retried here.
RestartPreventExitStatus=3

# No privileges needed: create the user once with
#   useradd --system --home-dir /var/lib/wgft --shell /usr/sbin/nologin wgft
User=wgft
Group=wgft
# Credentials (agent.json) live in /var/lib/wgft, the default of --data-dir.
StateDirectory=wgft
StateDirectoryMode=0700

# The agent only needs sockets and its state directory. AF_NETLINK is required: wireguard-go
# watches interface changes over netlink.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
