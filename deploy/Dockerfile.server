# Container for the VPS-side server, running the userspace mode only (docs/design.md section
# 6.3): wireguard-go + gVisor netstack, so it needs neither a TUN device, NET_ADMIN, nftables,
# nor host networking. Kernel mode (section 6.1) configures wg0 and nftables over netlink and is
# not supported in a container; run it as the systemd unit in deploy/server.service instead.
#
#   docker build -f deploy/Dockerfile.server -t wgft-server:latest .
#   docker build -f deploy/Dockerfile.server --build-arg VERSION=v0.1.0 -t wgft-server:v0.1.0 .
#   docker buildx build -f deploy/Dockerfile.server --platform linux/amd64,linux/arm64 ...   # release.yml
#
# The build stage runs on the builder's own platform and cross-compiles for the target, so a
# multi-platform build needs no emulation (Go cross-compiles; the binary is static).
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# VERSION is what `wgft --version` prints; the release workflow passes the git tag.
ARG VERSION=dev
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w -X github.com/rahanahu/wgft/internal/vpsd.Version=$VERSION" -o /out/wgft ./cmd/wgft
# License text of every module linked into the binary, shipped next to LICENSE in the image.
RUN scripts/third-party-licenses.sh /out/THIRD_PARTY_LICENSES.txt
# Pre-create the data dir owned by the distroless "nonroot" user (65532:65532). The final stage
# has no shell to chown it, and a named volume is initialised from this directory on first use,
# ownership included, so it must already be right here. It also holds the admin socket, since
# WGFT_ADMIN's default (unix:///run/wgft/admin.sock) is not writable by a non-root process.
RUN mkdir -p /out/var-lib-wgft && chown 65532:65532 /out/var-lib-wgft

# distroless static: a minimal image with no shell and no package manager. No privileges added.
FROM gcr.io/distroless/static-debian12:latest
COPY --from=build /out/wgft /usr/local/bin/wgft
COPY LICENSE /usr/share/doc/wgft/LICENSE
COPY --from=build /out/THIRD_PARTY_LICENSES.txt /usr/share/doc/wgft/THIRD_PARTY_LICENSES.txt
# Where the server database (wgft.sqlite) and the admin socket live. Use a named volume so the
# database, keys and certificates survive restarts.
COPY --from=build --chown=65532:65532 /out/var-lib-wgft /var/lib/wgft
VOLUME ["/var/lib/wgft"]
# Run as the distroless "nonroot" user (uid 65532, gid 65532) instead of root: the userspace mode
# needs no privilege, and the default admin socket path (/run/wgft) is root-owned, so it is moved
# into the writable data volume instead.
USER nonroot:nonroot
ENV WGFT_MODE=userspace
ENV WGFT_ADMIN=unix:///var/lib/wgft/admin.sock
ENTRYPOINT ["/usr/local/bin/wgft", "server", "run"]
