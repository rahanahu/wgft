[Unit]
Description=wgft server
Documentation=https://github.com/rahanahu/wgft#readme
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
# Configuration is WGFT_* in /etc/wgft/server.env. The binary reads that file by default, so no
# EnvironmentFile= here (with it, every value would show up as coming from the environment and
# the startup printout of "value and source" would be useless).
ExecStart=/usr/local/bin/wgft server run
Restart=on-failure
RestartSec=2
# A refusal caused by configuration (someone else's WireGuard interface, a port or address
# clash; exit code 3) does not go away on restart, so do not loop on it.
RestartPreventExitStatus=3
# Optional, off by default: a hard cgroup memory cap for this service. wgft also sets a Go runtime
# soft limit derived from the flow caps (printed at startup; 216 MiB with the default caps), but a
# soft limit is not a hard RSS ceiling. If you enable MemoryMax=, keep it above the printed soft
# limit. In the lab, userspace mode with the default flow caps stayed within 300M under a held-flow
# attack; a deliberately small 60M limit OOM-killed the service after 8 s and Restart= brought it
# back 2 s later.
#MemoryMax=300M
#MemorySwapMax=0

# Not root. systemd allocates an unprivileged user for the lifetime of the service and hands it two
# capabilities: CAP_NET_ADMIN for kernel WireGuard, nftables, conntrack and the net.ipv4.ip_forward
# sysctl, CAP_NET_BIND_SERVICE for proxy-mode rules that listen below 1024.
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
# Data lives in /var/lib/wgft (default of --data-dir). With DynamicUser= the real directory is
# /var/lib/private/wgft and /var/lib/wgft is a symlink to it; a directory left by an older
# root-run unit is moved there and re-owned on the first start. root can still read it, so
# `wgft server teardown` and the CLI keep working as before.
StateDirectory=wgft
StateDirectoryMode=0700
# The admin API Unix socket lives in /run/wgft (default of --admin, unix:///run/wgft/admin.sock).
# RuntimeDirectory creates it 0700 for the service user and removes it on stop; only root and the
# service itself can reach the socket.
RuntimeDirectory=wgft
RuntimeDirectoryMode=0700

# Sandbox.
NoNewPrivileges=yes
# The file system is read-only except StateDirectory= and RuntimeDirectory= above.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# ProtectKernelTunables= stays off: it makes /proc/sys read-only, and the server sets
# net.ipv4.ip_forward to 1 at startup when it is 0.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
