#!/usr/bin/env bash
# wgft の開発用ラボを操作する(ホストで実行する)。詳しくは lab/README.md。
set -euo pipefail

VM=${WGFT_LAB_VM:-wgft-lab}
IMAGE=${WGFT_LAB_IMAGE:-images:debian/13}
# ラボの参照のカーネル。Debian 13 (trixie) の VM には trixie-backports のこの版を入れて起動する。
# 版は package の版まで固定し、docs/design/userspace/wgstack-verification.md の「参照の Linux の設定」に
# 記録する。上げるときはここと記録と internal/tcpharness/linuxdut の ReferenceRelease を同じ変更で
# 直し、基の VM を作り直す。trixie 以外の image
# (WGFT_LAB_IMAGE=images:debian/12 など) には入れず、image のカーネルのまま動かす
# trixie-backports は新しい版が出ると古い版を消すので、package は snapshot.debian.org のこの時刻の
# trixie-backports から取る。時刻はこの版が載っている間の時刻にする
LAB_KERNEL_ABI=7.2.11+deb13-amd64
LAB_KERNEL_VERSION=7.2.11-1~bpo13+1
LAB_KERNEL_SNAPSHOT=20261101T000000Z
CPU=${WGFT_LAB_CPU:-2}
MEM=${WGFT_LAB_MEM:-2GiB}
# WGFT_LAB_CPUS はホストの CPU の集合(例 0-7 や 0-3,8)。値があれば、lab が作る VM の vCPU をこの中の
# CPU に 1 対 1 で固定する。vCPU の数は変えず、lab suite の VM には重ならない別々の CPU を割り当てる。
# 足りなければ VM を作らずに止まる。未設定なら固定せず、数だけの limits.cpu で今までどおり作る
CPUS=${WGFT_LAB_CPUS:-}
SNAPSHOT=clean
REPO=$(cd "$(dirname "$0")/.." && pwd)
SHARE=/wgft  # VM 内でのリポジトリの場所(読み取り専用)
NAMESPACES=(client vps homerouter home lan)

die() { echo "lab: $*" >&2; exit 1; }
info() { echo "lab: $*" >&2; }
case ${WGFT_LAB_AGENT_IMPL:-} in
  "" | go | rust) ;;
  *) die "WGFT_LAB_AGENT_IMPL=$WGFT_LAB_AGENT_IMPL: want go or rust" ;;
esac

# ---- WGFT_LAB_CPUS:VM の vCPU を CPU の集合に固定する ----
# Incus の limits.cpu は数 (2) なら vCPU の数だけを決めて CPU は浮かせ、集合 (0-1 や 0,2) なら
# 集合の CPU の数を vCPU の数にして 1 対 1 で固定する。固定は起動の前にしか変えられない。
# 1 つの CPU の集合は数と区別できないので、Incus の決まりどおり N-N と書く

# cpus_expand:WGFT_LAB_CPUS を CPU の番号の並び CPU_LIST にする ("0-3,8" なら 0 1 2 3 8)。
# 書式の誤り、逆順の範囲、オンラインでない CPU で止まる。die が効くよう、コマンド置換の中で呼ばない
CPU_LIST=()
cpus_expand() {
  local part a b i online on=" " seen=" "
  CPU_LIST=()
  [[ $CPUS =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] \
    || die "WGFT_LAB_CPUS='$CPUS' is not a CPU set; write it like 0-7 or 0-3,8"
  # オンラインの CPU の集合 (例 0-23)。番号が飛ぶことがあるので、数ではなく集合で確かめる
  online=$(cat /sys/devices/system/cpu/online)
  IFS=, read -ra parts <<<"$online"
  for part in "${parts[@]}"; do
    for ((i = 10#${part%-*}; i <= 10#${part#*-}; i++)); do on+="$i "; done
  done
  IFS=, read -ra parts <<<"$CPUS"
  for part in "${parts[@]}"; do
    a=$((10#${part%-*})) b=$((10#${part#*-}))
    ((a <= b)) || die "WGFT_LAB_CPUS='$CPUS': the range $part goes backwards"
    for ((i = a; i <= b; i++)); do
      [[ $on == *" $i "* ]] || die "WGFT_LAB_CPUS='$CPUS': CPU $i is not online; the online CPUs are $online"
      [[ $seen == *" $i "* ]] && continue
      seen+="$i "
      CPU_LIST+=("$i")
    done
  done
}

# cpus_join <CPU...>:"0 1 2 5" を limits.cpu の集合 "0-2,5" にする。1 つだけなら "5-5"
cpus_join() {
  local out="" s=$1 p=$1 x
  shift
  for x in "$@"; do
    if ((x == p + 1)); then p=$x; continue; fi
    if [[ $s == "$p" ]]; then out+="${out:+,}$s"; else out+="${out:+,}$s-$p"; fi
    s=$x p=$x
  done
  if [[ $s == "$p" ]]; then out+="${out:+,}$s"; else out+="${out:+,}$s-$p"; fi
  [[ $out == *[,-]* ]] || out="$out-$out"
  echo "$out"
}

# vcpu_count <limits.cpu の値>:VM の vCPU の数。空は Incus の既定の 1、集合はその CPU の数
vcpu_count() {
  local v=$1 part n=0
  if [[ -z $v ]]; then echo 1; return; fi
  if [[ $v =~ ^[0-9]+$ ]]; then echo "$v"; return; fi
  IFS=, read -ra parts <<<"$v"
  for part in "${parts[@]}"; do n=$((n + 10#${part#*-} - 10#${part%-*} + 1)); done
  echo "$n"
}

# cpus_plan <VM の数> <1 台の vCPU の数>:WGFT_LAB_CPUS を先頭から順に切り分け、1 台に 1 つの集合を
# CPU_PLAN に入れる。足りなければ止まる。重ねて固定することはしない
CPU_PLAN=()
cpus_plan() {
  local vms=$1 per=$2 i
  cpus_expand
  ((vms * per <= ${#CPU_LIST[@]})) \
    || die "WGFT_LAB_CPUS=$CPUS has ${#CPU_LIST[@]} CPUs, but $vms VM(s) of $per vCPUs need $((vms * per)); widen the set, use fewer VMs, or unset WGFT_LAB_CPUS"
  CPU_PLAN=()
  for ((i = 0; i < vms; i++)); do CPU_PLAN+=("$(cpus_join "${CPU_LIST[@]:i*per:per}")"); done
}

# incus-admin グループへの追加が今のログインセッションに反映されていなくても動くようにする
if incus info >/dev/null 2>&1; then
  inc() { incus "$@"; }
elif getent group incus-admin | cut -d: -f4 | tr ',' '\n' | grep -qx "$(id -un)"; then
  inc() { sg incus-admin -c "$(printf '%q ' incus "$@")"; }
else
  die "incus を操作する権限がない(incus-admin グループに入れてログインし直す)"
fi

vm_exists() { inc info "$VM" >/dev/null 2>&1; }
# `incus list <名前>` は前方一致なので、wgft-lab が wgft-lab2 も拾う。名前の完全一致で絞る
vm_state() { inc list -c ns -f csv | awk -F, -v vm="$VM" '$1 == vm { print $2 }'; }
has_snapshot() { inc snapshot list "$VM" -f csv -c n | grep -qx "$SNAPSHOT"; }
wait_agent() { timeout 300 bash -c "$(declare -f inc); $(printf '%q ' inc wait "$VM" agent)" || die "VM の agent が起動しない"; }
# agent は IP アドレスが付く前に応答するので、起動直後に外と通信するなら別に待つ。
# 付かなくてもトポロジ(VM 内の netns)には影響しないので、止めずに警告だけ出す
wait_net() {
  # lab paired --split の VM は IP の無い NIC を持ち、incus wait ip はその NIC も待つので、IPv4 の有無を自分で見る
  if [[ -n ${SUITE_NIC_NET:-} ]]; then
    timeout 120 bash -c "$(declare -f inc); until inc list $(printf %q "$VM") -c 4 -f csv | grep -q '[0-9]'; do sleep 1; done" \
      || info "VM に IP アドレスが付かない(外部との通信は失敗する)"
    return 0
  fi
  timeout 120 bash -c "$(declare -f inc); $(printf '%q ' inc wait "$VM" ip --interval 2)" || info "VM に IP アドレスが付かない(外部との通信は失敗する)"
}
# WGFT_LAB_AGENT_NETSTACK はユーザー空間モードのエージェントの netstack(gvisor か wgstack)を選ぶ。
# 値があれば VM の中のコマンドに WGFT_AGENT_NETSTACK として渡し、ラボの確認が起動するエージェントがそれを継ぐ。
# 未設定なら何も渡さず、エージェントは既定の gvisor で動く。
# WGFT_LAB_AGENT_IMPL はユーザー空間モードのエージェントの実装(go か rust)を選ぶ。値があれば VM の中のコマンドに
# そのまま渡し、lab/sandbox.sh がそれで AGENT_WGFT を決める。未設定なら go と同じ
# (docs/design/v2/agent-parity.md の「ラボの切り替え」)
in_vm() {
  local env=()
  [[ -n ${WGFT_LAB_AGENT_NETSTACK:-} ]] && env+=(--env "WGFT_AGENT_NETSTACK=$WGFT_LAB_AGENT_NETSTACK")
  [[ -n ${WGFT_LAB_AGENT_IMPL:-} ]] && env+=(--env "WGFT_LAB_AGENT_IMPL=$WGFT_LAB_AGENT_IMPL")
  inc exec "$VM" "${env[@]}" --cwd "$SHARE" -- "$@"
}

ensure_running() {
  vm_exists || die "VM '$VM' がない(lab up で作る)"
  if [[ $(vm_state) == RUNNING ]]; then
    wait_agent
  else
    inc start "$VM"
    wait_agent
    wait_net
  fi
}

provision() {
  info "VM に開発用パッケージを入れる"
  inc exec "$VM" --env "LAB_KERNEL_ABI=$LAB_KERNEL_ABI" --env "LAB_KERNEL_VERSION=$LAB_KERNEL_VERSION" \
    --env "LAB_KERNEL_SNAPSHOT=$LAB_KERNEL_SNAPSHOT" -- bash -s <<'EOF'
set -euo pipefail
# ホストの firewalld / Docker の影響で IPv4 の DNS が引けない場合は、IPv6 の DNS に切り替える(lab/README.md)
# /etc/resolv.conf は /run(tmpfs)へのシンボリックリンクなので、直接書くと再起動で消える。resolved の設定に書く
# deb.debian.org はここでは到達性を確かめるための外部ホスト名で、パッケージの取得先とは関係ない
# (dnf 系のディストリでも、resolved の設定を直す判断にそのまま使える)
if ! getent hosts deb.debian.org >/dev/null; then
  echo "IPv4 の DNS が使えないので IPv6 の DNS を使う" >&2
  if systemctl is-active -q systemd-resolved; then
    mkdir -p /etc/systemd/resolved.conf.d
    printf '[Resolve]\nDNS=2001:4860:4860::8888 2606:4700:4700::1111\n' > /etc/systemd/resolved.conf.d/wgft-lab-ipv6-dns.conf
    systemctl restart systemd-resolved
  else
    rm -f /etc/resolv.conf
    printf 'nameserver 2001:4860:4860::8888\nnameserver 2606:4700:4700::1111\n' > /etc/resolv.conf
  fi
  getent hosts deb.debian.org >/dev/null || { echo "IPv6 の DNS でも名前を引けない" >&2; exit 1; }
fi

# パッケージ名とパッケージ管理コマンドはディストリごとに違う。/etc/os-release の ID で分ける。
# Debian の分岐は元のコマンド列のまま(既定のイメージの挙動を変えない)。ID_LIKE ではなく ID を
# 見るのは、Ubuntu を Debian と同じ枝に、素の Fedora だけを dnf の枝に、明示的に振り分けるため
. /etc/os-release
case "$ID" in
  debian | ubuntu)
    export DEBIAN_FRONTEND=noninteractive
    # 前回の lab up を途中で止めた場合などに、dpkg のロックが空くまで待つ
    apt_opts=(-q -o DPkg::Lock::Timeout=600)
    dpkg --configure -a
    apt-get "${apt_opts[@]}" update
    apt-get "${apt_opts[@]}" install -y --no-install-recommends \
      nftables iptables wireguard-tools conntrack iproute2 procps tcpdump iperf3 socat curl podman
    if [[ $ID == debian && ${VERSION_CODENAME:-} == trixie ]]; then
      # 参照のカーネル (lab/lab の LAB_KERNEL_ABI) を、snapshot.debian.org の固定した時刻の
      # trixie-backports から版を固定して入れる。依存の linux-base も同じ時刻の backports の版になる。
      # snapshot の Release は期限が切れているので check-valid-until=no にする。GRUB は新しい版を
      # 先に起動するので、6.12 を残しても次の起動はこの版になる。起動した版は cmd_up が確かめる
      echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/$LAB_KERNEL_SNAPSHOT/ trixie-backports main" \
        > /etc/apt/sources.list.d/wgft-lab-backports.list
      apt-get "${apt_opts[@]}" -o Acquire::Retries=3 update
      apt-get "${apt_opts[@]}" -o Acquire::Retries=3 install -y --no-install-recommends -t trixie-backports \
        "linux-image-$LAB_KERNEL_ABI=$LAB_KERNEL_VERSION"
      # Debian 13 は /tmp を tmpfs にする。Debian 12 と同じくディスクに置き、確認のログと一時ファイルが
      # 2 GiB の VM のメモリを使わないようにする。次の起動から効く
      systemctl mask tmp.mount
    fi
    ;;
  fedora)
    # conntrack のコマンドは conntrack-tools、iproute2 相当は iproute、procps 相当は procps-ng という
    # パッケージ名になる。python3 は lab の各シナリオが使うが、Fedora の Cloud Base イメージには
    # 既定で入っていないため、ここで明示的に入れる(Debian 系は既定のイメージに入っている)
    dnf -y makecache
    dnf -y install \
      nftables iptables wireguard-tools conntrack-tools iproute procps-ng tcpdump iperf3 socat curl podman python3
    ;;
  *)
    echo "lab: 未対応のディストリ(/etc/os-release の ID=$ID)。lab/lab の provision() に分岐を足す" >&2
    exit 1
    ;;
esac
# ラボで使わない定時の仕事と常駐を止める。パッケージの一覧の更新などの定時の仕事が確認の最中に走ると、
# CPU とメモリを使う。tty1 の getty と polkit はラボで使わない。シリアルの getty は incus console が使うので
# 残す。無い unit は飛ばす。journal は 32 MiB までにする
for unit in apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer e2scrub_all.timer fstrim.timer \
  man-db.timer dnf-makecache.timer; do
  systemctl disable --now "$unit" >/dev/null 2>&1 || true
done
systemctl mask getty@tty1.service polkit.service >/dev/null 2>&1 || true
mkdir -p /etc/systemd/journald.conf.d
printf '[Journal]\nSystemMaxUse=32M\nRuntimeMaxUse=16M\n' > /etc/systemd/journald.conf.d/wgft-lab.conf
mkdir -p /var/lib/wgft-lab && touch /var/lib/wgft-lab/provisioned
EOF
}

# kernel_up:Debian 13 の VM が参照のカーネル (LAB_KERNEL_ABI) で動いていなければ、再起動してそれで起こす。
# 再起動の後も違えば止まる。スナップショットはこの後に取るので、clean には参照のカーネルで動く状態が残る
kernel_up() {
  local codename running
  codename=$(inc exec "$VM" -- sh -c '. /etc/os-release; echo "$ID/${VERSION_CODENAME:-}"')
  [[ $codename == debian/trixie ]] || return 0
  running=$(inc exec "$VM" -- uname -r)
  [[ $running == "$LAB_KERNEL_ABI" ]] && return 0
  info "restarting '$VM' to boot the reference kernel $LAB_KERNEL_ABI; it runs $running"
  inc restart "$VM"
  wait_agent
  wait_net
  running=$(inc exec "$VM" -- uname -r)
  [[ $running == "$LAB_KERNEL_ABI" ]] \
    || die "'$VM' runs kernel $running after the restart, not the reference $LAB_KERNEL_ABI; a VM provisioned for another kernel keeps it, so rebuild it with lab destroy and lab up"
}

cmd_up() {
  if ! vm_exists; then
    local lcpu=$CPU
    if [[ -n $CPUS ]]; then
      [[ $CPU =~ ^[1-9][0-9]*$ ]] || die "WGFT_LAB_CPU=$CPU must be a count of vCPUs when WGFT_LAB_CPUS is set"
      cpus_plan 1 "$CPU"
      lcpu=${CPU_PLAN[0]}
      info "pinning the $CPU vCPUs of '$VM' to CPUs $lcpu of WGFT_LAB_CPUS=$CPUS"
    fi
    info "VM '$VM' を作る($IMAGE, cpu=$lcpu, mem=$MEM)"
    inc init "$IMAGE" "$VM" --vm -c "limits.cpu=$lcpu" -c "limits.memory=$MEM"
    # 9p はホットプラグできないので、起動前に追加する
    inc config device add "$VM" repo disk source="$REPO" path="$SHARE" readonly=true
  fi
  ensure_running
  inc exec "$VM" -- test -f /var/lib/wgft-lab/provisioned || provision
  kernel_up
  if ! has_snapshot; then
    info "スナップショット '$SNAPSHOT' を作る"
    # 直前の書き込み(provisioned の印など)がディスクに届く前に取ると、巻き戻したときに消える
    inc exec "$VM" -- sync
    inc snapshot create "$VM" "$SNAPSHOT"
  fi
  cmd_net up
}

cmd_reset() {
  vm_exists || die "VM '$VM' がない(lab up で作る)"
  has_snapshot || die "スナップショット '$SNAPSHOT' がない(lab up で作る)"
  info "スナップショット '$SNAPSHOT' に戻す"
  [[ $(vm_state) == STOPPED ]] || inc stop "$VM" --force
  inc snapshot restore "$VM" "$SNAPSHOT"
  ensure_running
  cmd_net up
}

cmd_destroy() {
  vm_exists || { info "VM '$VM' はない"; return; }
  if [[ ${1:-} != --yes ]]; then
    read -r -p "VM '$VM' とスナップショットを削除する。よい? [y/N] " ans
    [[ $ans == [yY] ]] || die "中止"
  fi
  inc delete "$VM" --force
}

# sysctl_up:ユーザー空間モードの動作条件(docs/manual/socket-buffers.md)のとおり、VM 全体の
# net.core.rmem_max と net.core.wmem_max を 7340032 にする。ラボは server と agent を権限のない
# 利用者 wgftlab でも動かすので、既定の 212992 のままでは WireGuard の UDP の受信のバッファが溢れ、
# gVisor の TCP が回復の状態で止まりかけて、usage.sh などの転送がときどき遅くなる。
# 値は network namespace で隔てられないので、Sandbox ごとに呼ばれる netns.sh ではなく、確認を流す
# 前の共有の準備であるここで 1 回だけ書く。/etc/sysctl.d に置くので、VM を再起動しても値が戻る。
# 手順書と同じ書き方にするが、ファイル名は手順書の 90-wgft.conf と分ける。そのファイルは
# lifecycle.sh の check 12 が自分で書いて消すためである。check 12 は値を一時的に下げ、この
# ファイルを確認の間だけ別の場所へ移し、終わると両方を開始時に戻す(lab/suite.txt の exclusive-global)。
# labhost run は、プールと単独の仕事の前に値がこれを下回れば警告する
sysctl_up() {
  in_vm sh -c 'printf "net.core.rmem_max = 7340032\nnet.core.wmem_max = 7340032\n" > /etc/sysctl.d/80-wgft-lab.conf && sysctl -q -p /etc/sysctl.d/80-wgft-lab.conf'
}

cmd_net() {
  case "${1:-}" in
    up) ensure_running; sysctl_up; in_vm "$SHARE/lab/netns.sh" up ;;
    down | status) ensure_running; in_vm "$SHARE/lab/netns.sh" "$1" ;;
    *) die "usage: lab net up|down|status" ;;
  esac
}

# lab exec <ns|vm> <command...>:VM 内(ns 指定ならその netns 内)で、/wgft を作業ディレクトリにして実行
cmd_exec() {
  [[ $# -ge 2 ]] || die "usage: lab exec <$(IFS='|'; echo "${NAMESPACES[*]}")|vm> <command...>"
  local target=$1; shift
  ensure_running
  if [[ $target == vm ]]; then
    in_vm "$@"
  else
    printf '%s\n' "${NAMESPACES[@]}" | grep -qx "$target" || die "不明な ns: $target"
    in_vm ip netns exec "$target" "$@"
  fi
}

cmd_shell() {
  local target=${1:-vm}
  if [[ $target == vm ]]; then cmd_exec vm bash; else cmd_exec "$target" bash; fi
}

# lab build:ホストで静的バイナリを bin/ に作り、VM の /usr/local/bin に install する。
# 9p 上の bin/ を VM で直接 exec すると、そのバイナリを実行中のプロセスがいる間にホストで上書きしたとき、
# ページキャッシュに残った古いページと新しいページが混ざって SIGSEGV になる(実験で確認)。
# install(1) は unlink してから書くので、実行中のプロセスは古い inode のまま動き続け、新しい exec は新しい方を読む
# rust_build <ソースの木> <target> <入れる先> [<cargo の target ディレクトリ> [<cargo の feature>]]:木の wgft を
# cargo-zigbuild で作り、入れる先に install する。target ディレクトリを渡さなければ <木>/target に作る。
# zigbuild の target の glibc の版 (x86_64-unknown-linux-gnu.2.41 の .2.41) は出力の置き場の名前に入らない
rust_build() {
  local src=$1 target=$2 dest=$3 tdir=${4:-} feat=${5:-} envs=()
  command -v cargo-zigbuild >/dev/null || die "the Rust build needs cargo-zigbuild and zig on the host"
  [[ -z $tdir ]] || envs=(env CARGO_TARGET_DIR="$tdir")
  (cd "$src" && "${envs[@]}" cargo zigbuild --release --locked --target "$target" -p wgft ${feat:+--features "$feat"}) \
    && install -D -m 0755 "${tdir:-$src/target}/${target%%.*}/release/wgft" "$dest"
}
host_build() {
  [[ -f $REPO/go.mod ]] || die "go.mod がまだない"
  # WGFT_LAB_BUILD_TAGS は go build の -tags に渡す。lab/agentmem.sh は labmemprobe を付けた build を要る
  (cd "$REPO" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath ${WGFT_LAB_BUILD_TAGS:+-tags "$WGFT_LAB_BUILD_TAGS"} -o bin/ ./cmd/... ./tools/...)
  # Rust の wgft は、WGFT_LAB_AGENT_IMPL=rust、--agent-impl に rust を含む lab suite のとき
  # bin/rust/wgft に作る。cargo-zigbuild で musl の静的バイナリにし、VM の Debian の glibc に依らない。
  # WGFT_LAB_RUST_TARGET は Rust の wgft の target で、既定は x86_64-unknown-linux-musl。
  # x86_64-unknown-linux-gnu.2.17 のような glibc の target にすると、libc と割り当て器の違う build を測れる。
  # glibc の版 (.2.17) は zig が結ぶ glibc の下限で、VM の Debian の glibc はそれ以上でなければならない。
  # 既定の bin/ とその install は変えない
  if rust_wanted; then
    local rtarget=${WGFT_LAB_RUST_TARGET:-x86_64-unknown-linux-musl}
    rust_build "$REPO" "$rtarget" "$REPO/bin/rust/wgft" "" "${LAB_RUST_FEATURES:-}" || die "cargo zigbuild failed"
    info "built the Rust wgft for $rtarget into $REPO/bin/rust/"
  fi
  info "built into $REPO/bin/"
}
# rust_wanted:この build が Rust の wgft を作って入れるか。LAB_BUILD_RUST は lab suite が --agent-impl で決める
rust_wanted() { [[ ${WGFT_LAB_AGENT_IMPL:-} == rust || ${LAB_BUILD_RUST:-} == 1 ]]; }
# vm_install:Go のバイナリを /usr/local/bin に入れる。Rust の wgft は名前を wgft のまま /usr/local/lib/wgft-rust/ に
# 入れる。ラボの台本がプロセスを comm の wgft と cmdline の " agent run" で探すためで、lab/sandbox.sh の
# AGENT_WGFT がこのパスを指す
vm_install() {
  in_vm sh -c 'for b in /wgft/bin/*; do [ -f "$b" ] && [ -x "$b" ] && case "$b" in *.test) ;; *) install -m 0755 "$b" /usr/local/bin/;; esac; done; ls /usr/local/bin/'
  if rust_wanted; then
    in_vm sh -c 'install -d -m 0755 /usr/local/lib/wgft-rust && install -m 0755 /wgft/bin/rust/wgft /usr/local/lib/wgft-rust/wgft'
  fi
  info "installed into VM $VM /usr/local/bin (use plain command names in the VM)$(rust_wanted && echo "; the Rust wgft as /usr/local/lib/wgft-rust/wgft")"
}
cmd_build() {
  # 機能の確認 (labhost run all) が使う build なので、lifecycle.sh の check 5 と 5b の行を出す lab-observe を付ける。
  # 性能を測る lab paired は付けない
  LAB_RUST_FEATURES=lab-observe host_build
  if vm_exists && [[ $(vm_state) == RUNNING ]]; then vm_install; fi
}


# ---- lab suite:一時的な VM を N 台立て、一式を shard に分けて同時に流し、1 つの判定にまとめる ----
# 一時的な VM は WGFT_LAB_TEMPLATE(既定は WGFT_LAB_VM)のスナップショット clean の複製で、リポジトリの
# 共有はこの作業ツリーを指す。CPU とメモリの上限はスナップショットのまま継ぐ。WGFT_LAB_CPUS があれば、
# vCPU の数はそのままに、各 VM を集合の別々の CPU に固定する。スナップショットが
# 無ければ lab up と同じ手順で新規に作る(遅い)。
# 作った VM には user.wgft-lab-suite=<この lab の PID> を付ける。正常終了、INT、TERM、HUP では trap が
# 全部消す。SIGKILL や電源断で残った VM は、PID が死んでいれば次の lab suite の開始時と lab suite-gc が消す
SUITE_VMS=()
SUITE_CLEANING=0
SUITE_PIN=""

# suite_alive <pid>:その PID のプロセスがあるか。kill -0 は他の利用者のプロセスに EPERM で失敗し、
# 生きている run を死んだと読んでその VM を消してしまうので、/proc で見る
suite_alive() { [[ -d /proc/$1 ]]; }

suite_delete_vms() { # suite_delete_vms <name...>:並行して強制削除する。削除の失敗は終了コードに入れない
  local n
  for n in "$@"; do inc delete "$n" --force >/dev/null 2>&1 & done
  wait
}

cmd_suite_gc() {
  local name pid dead=()
  # 名前の前方一致ではなく、印の user.wgft-lab-suite で選ぶ
  while IFS=, read -r name pid; do
    [[ -n $name && -n $pid ]] || continue
    suite_alive "$pid" || dead+=("$name")
  done < <(inc list -f csv -c n,user.wgft-lab-suite 2>/dev/null | grep -E ',[0-9]+$' || true)
  if ((${#dead[@]})); then
    info "deleting suite VMs whose lab process is gone: ${dead[*]}"
    suite_delete_vms "${dead[@]}"
  fi
  # lab paired --split のネットワーク wgftsp<PID>:作った lab の PID が無く、どの instance も使っていなければ消す。
  # SIGKILL、--keep の後に VM を手で消した場合、削除の失敗で残ったもの
  local net used
  while IFS=, read -r net used; do
    [[ $net =~ ^wgftsp([0-9]+)$ ]] || continue
    suite_alive "${BASH_REMATCH[1]}" && continue
    [[ $used == 0 ]] || continue
    info "deleting the split network $net whose lab process is gone"
    inc network delete "$net" >/dev/null 2>&1 || info "could not delete the network $net"
  done < <(inc network list -f csv -c n,u 2>/dev/null || true)
  # lab paired --split のホストの標本 (tcpquality.py hostsample --lab-pid=<PID>):作った lab が無いものを止める。
  # 標本は lab が消えると次の標本で自分でも止まる。ここでは /proc の引数を 1 つずつ見て、印の付いたものだけを選ぶ
  local p args lab
  for p in /proc/[0-9]*; do
    args=$(tr '\0' '\n' 2>/dev/null <"$p/cmdline") || continue
    grep -qx hostsample <<<"$args" && grep -q '/tcpquality.py$' <<<"$args" || continue
    lab=$(sed -n 's/^--lab-pid=\([0-9][0-9]*\)$/\1/p' <<<"$args")
    [[ -n $lab ]] && ! suite_alive "$lab" || continue
    info "stopping the host sampler ${p#/proc/} whose lab process $lab is gone"
    kill "${p#/proc/}" 2>/dev/null || true
  done
}

suite_cleanup() {
  ((SUITE_CLEANING)) && return
  SUITE_CLEANING=1
  trap '' INT TERM HUP
  local p
  for p in $(jobs -p); do kill "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
  if ((${#SUITE_VMS[@]})) && [[ -z ${SUITE_KEEP:-} ]]; then
    info "deleting the suite VMs: ${SUITE_VMS[*]}"
    suite_delete_vms "${SUITE_VMS[@]}"
    [[ -n ${SUITE_T0:-} ]] && info "suite wall time with VM deletion: $((SECONDS - SUITE_T0)) s"
  elif ((${#SUITE_VMS[@]})); then
    info "--keep: leaving the suite VMs ${SUITE_VMS[*]}; delete them with incus delete --force"
  fi
}

# suite_timeout <秒> <コマンド...>:シェル関数の in_vm と inc も timeout で止められるよう、子の bash で流す。
# 1 台の VM の agent や incus exec が固まっても、run 全体が止まったままにならない
suite_timeout() {
  local sec=$1; shift
  timeout -k 30 "$sec" bash -c "$(declare -f inc in_vm); VM=$(printf %q "$VM"); SHARE=$(printf %q "$SHARE"); WGFT_LAB_AGENT_NETSTACK=$(printf %q "${WGFT_LAB_AGENT_NETSTACK:-}"); WGFT_LAB_AGENT_IMPL=$(printf %q "${WGFT_LAB_AGENT_IMPL:-}"); \"\$@\"" suite_timeout "$@"
}

# suite_boot:VM を起動し、agent が応答するまで待つ。複数の VM を同時に起こすと agent が上がらない
# VM が出たことがあるので(試した 1 回で 300 秒待っても上がらなかった)、90 秒で見切って強制停止し、起動し直す
suite_boot() {
  local try
  for try in 1 2 3; do
    inc start "$VM" >/dev/null 2>&1 || true
    if timeout 90 bash -c "$(declare -f inc); $(printf '%q ' inc wait "$VM" agent)" >/dev/null 2>&1; then
      wait_net
      return 0
    fi
    info "the agent of $VM did not answer within 90 s, try $try; stopping it and starting again"
    inc stop "$VM" --force >/dev/null 2>&1 || true
  done
  info "$VM does not start"
  return 1
}

# suite_make_vm <name>:複製を作って起動する。作った名前は呼び出し側が先に SUITE_VMS に入れ、途中で止まっても trap が消せるようにする
# WGFT_LAB_CPUS があれば、cmd_suite がこの VM に割り当てた集合 SUITE_PIN を起動の前に limits.cpu に入れる
suite_make_vm() {
  local name=$1 tmpl=$SUITE_TEMPLATE pin=()
  VM=$name
  [[ -n $SUITE_PIN ]] && pin=(-c "limits.cpu=$SUITE_PIN")
  # lab paired の PAIRED_HOSTPOLL_*:ゲストが MSR_KVM_POLL_CONTROL を書く。Secure Boot で起動した Debian のカーネルは
  # lockdown (integrity) で /dev/cpu/*/msr への書き込みを断る (EPERM、2026-11-04 にラボで確認) ので、その時だけ切る
  [[ -n ${SUITE_NO_SECUREBOOT:-} ]] && pin+=(-c security.secureboot=false)
  if inc snapshot list "$tmpl" -f csv -c n 2>/dev/null | grep -qx "$SNAPSHOT"; then
    inc copy "$tmpl/$SNAPSHOT" "$name" -d "repo,source=$REPO" -c "user.wgft-lab-suite=$$" "${pin[@]}" >/dev/null || return 1
    # lab paired --split:2 台の VM を繋ぐ専用のネットワークの NIC。Incus は device を名前の順に PCI に並べるので、eth0 の後に
    # なる名前にし、DHCP の設定が付いた enp5s0 を既定の NIC に残す (中の名前は起動後に MAC で引く)
    if [[ -n ${SUITE_NIC_NET:-} ]]; then
      # bridged で付けると tap の送りの待ち行列 (queue.tx.length) を決められる。既定の 1000 では、相手の VM の vhost が
      # 遅れた時に agent の VM からの packet が tap で落ち、カーネルモードの TCP が再送した (2026-11-04)。
      # 長すぎると詰まった時の遅れが増えるので 4096 にし、落ちた数は hostsample が数える
      inc config device add "$name" eth1 nic nictype=bridged parent="$SUITE_NIC_NET" queue.tx.length="${PAIRED_TAP_QLEN:-4096}" >/dev/null || return 1
    fi
    suite_boot || return 1
    cmd_net up
  else
    info "template '$tmpl' has no snapshot '$SNAPSHOT'; provisioning '$name' from $IMAGE instead, which is slow"
    # 印は provision の前に付ける。provision の途中で SIGKILL されても suite-gc が見つけられるように
    inc init "$IMAGE" "$name" --vm -c "limits.cpu=${SUITE_PIN:-$CPU}" -c "limits.memory=$MEM" -c "user.wgft-lab-suite=$$" >/dev/null || return 1
    inc config device add "$name" repo disk source="$REPO" path="$SHARE" readonly=true >/dev/null || return 1
    cmd_up
  fi
}

# suite_barrier <dir...>:すべての shard の VM が用意できる (ready) か、用意に失敗する (failed) まで待つ。
# labhost run -shard は単独の仕事の時間窓を、台がそろって始まる前提の見積もりで決めるので、始まりをそろえる
suite_barrier() {
  local d waited=0
  while :; do
    local pending=0
    for d in "$@"; do [[ -f $d/ready || -f $d/failed ]] || pending=1; done
    ((pending)) || return 0
    if ((waited >= SUITE_BARRIER_MAX)); then
      echo "lab: some shard VMs were not ready after $SUITE_BARRIER_MAX s; starting without them"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

# suite_shard_body <name> <dir> <k> <n> <durations> <all dirs...>:1 台分。VM の起動から結果の回収まで。
# 呼び出し側が || で受けるため set -e が効かない。失敗しうる行は自分で || return する
suite_shard_body() {
  local name=$1 dir=$2 k=$3 n=$4 dur=$5 t0=$SECONDS t1 rc=0
  shift 5
  suite_make_vm "$name" || return 1
  vm_install >/dev/null || return 1
  # 一式の判定がどのカーネルの上のものかを、結果の要約に出す
  in_vm uname -r > "$dir/kernel" || return 1
  local extra=()
  if [[ -n $dur ]]; then
    inc file push "$dur" "$name/tmp/wgft-lab-durations.json" || return 1
    extra=(-durations /tmp/wgft-lab-durations.json)
  fi
  touch "$dir/ready"
  suite_barrier "$@"
  t1=$SECONDS
  echo "lab: shard $k/$n: VM ready after $((t1 - t0)) s; running"
  suite_timeout "$SUITE_TIMEOUT" in_vm labhost run -out /tmp/wgft-lab/suite -shard "$k/$n" -parallel "$SUITE_PARALLEL" "${extra[@]}" all || rc=$?
  echo "lab: shard $k/$n: labhost exited $rc after $((SECONDS - t1)) s"
  # 124 は timeout が止めたとき。137 は SIGKILL で、timeout -k の後のほか、VM の中の OOM killer でもなる
  if ((rc == 124 || rc == 137)); then
    if ((rc == 124)); then
      echo "lab: shard $k/$n: labhost did not finish within $SUITE_TIMEOUT s; stopped it, and the shard has no summary"
    else
      echo "lab: shard $k/$n: labhost or incus exec was killed, by the timeout's KILL or by the OOM killer in the VM; the shard has no summary"
    fi
    suite_timeout 300 inc file pull -r "$name/tmp/wgft-lab/suite/logs" "$dir/" >/dev/null 2>&1 || true
    return 1
  fi
  suite_timeout 300 inc file pull "$name/tmp/wgft-lab/suite/summary.json" "$dir/summary.json" || return 1
  suite_timeout 300 inc file pull -r "$name/tmp/wgft-lab/suite/logs" "$dir/" >/dev/null 2>&1 || true
  echo "$((t1 - t0)) $((SECONDS - t1)) $rc" > "$dir/times"
}

# suite_shard <name> <dir> <netstack> <agent impl> <k> <n> <durations> <all dirs...>:バックグラウンドで呼ぶ。
# 本体を子のシェルで流すのは、cmd_up などの die が exit しても failed の印を残すため
suite_shard() {
  local name=$1 dir=$2
  VM=$name
  WGFT_LAB_AGENT_NETSTACK=$3
  WGFT_LAB_AGENT_IMPL=$4
  mkdir -p "$dir"
  shift 4
  (suite_shard_body "$name" "$dir" "$@") > "$dir/shard.log" 2>&1 || echo failed > "$dir/failed"
  return 0
}

cmd_suite() {
  local vms=3 netstack=default keep= durations= out= parallel=8 timeout_s=${WGFT_LAB_SHARD_TIMEOUT:-3600}
  local agent_impl=${WGFT_LAB_AGENT_IMPL:-go}
  while (($#)); do
    case $1 in
      --vms) vms=${2:?--vms N}; shift 2 ;;
      --netstack) netstack=${2:?--netstack default|wgstack|both}; shift 2 ;;
      --agent-impl) agent_impl=${2:?--agent-impl go|rust|both}; shift 2 ;;
      --durations) durations=${2:?--durations FILE}; shift 2 ;;
      --parallel) parallel=${2:?--parallel N}; shift 2 ;;
      --shard-timeout) timeout_s=${2:?--shard-timeout SEC}; shift 2 ;;
      --out) out=${2:?--out DIR}; shift 2 ;;
      --keep) keep=1; shift ;;
      *) die "usage: lab suite [--vms N] [--netstack default|wgstack|both] [--agent-impl go|rust|both] [--durations summary.json] [--parallel N] [--shard-timeout SEC] [--out DIR] [--keep]" ;;
    esac
  done
  [[ $vms =~ ^[1-9][0-9]*$ ]] || die "--vms wants a whole number of 1 or more"
  [[ $parallel =~ ^[1-9][0-9]*$ ]] || die "--parallel wants a whole number of 1 or more"
  [[ $timeout_s =~ ^[1-9][0-9]*$ ]] || die "--shard-timeout wants a whole number of seconds"
  local nss=() impls=() cfgs=() i c
  case $netstack in
    default) nss=(default) ;;
    wgstack) nss=(wgstack) ;;
    both) nss=(default wgstack) ;;
    *) die "--netstack wants default, wgstack or both" ;;
  esac
  case $agent_impl in
    go) impls=(go) ;;
    rust) impls=(rust) ;;
    both) impls=(go rust) ;;
    *) die "--agent-impl wants go, rust or both" ;;
  esac
  # 組は <agent の実装>/<netstack>。Rust の agent は netstack を 1 つしか持たないので、rust の組は --netstack に
  # よらず 1 回だけ流し、netstack は既定のまま (default) にする。go の組を先に並べ、rust の組の統合が go の組の
  # 結果を使えるようにする
  for i in "${impls[@]}"; do
    if [[ $i == rust ]]; then
      cfgs+=(rust/default)
      LAB_BUILD_RUST=1
    else
      for c in "${nss[@]}"; do cfgs+=("go/$c"); done
    fi
  done
  [[ -z $durations || -f $durations ]] || die "no such --durations file: $durations"
  [[ -n $durations ]] && durations=$(cd "$(dirname "$durations")" && pwd)/$(basename "$durations")
  SUITE_KEEP=$keep
  SUITE_TEMPLATE=${WGFT_LAB_TEMPLATE:-$VM}  # suite_shard が VM を複製の名前に差し替える前に決める
  SUITE_PARALLEL=$parallel
  SUITE_TIMEOUT=$timeout_s
  SUITE_BARRIER_MAX=900
  # WGFT_LAB_CPUS:VM を作る前に全台の集合を決める。足りなければ何も作らずに止まる。
  # 1 台の vCPU の数は複製のもとのスナップショットの limits.cpu (無ければ WGFT_LAB_CPU) のまま変えない
  local total=$(( vms * ${#cfgs[@]} )) tcpu per pins=()
  if inc snapshot list "$SUITE_TEMPLATE" -f csv -c n 2>/dev/null | grep -qx "$SNAPSHOT"; then
    # 固定するときは読めないまま進まない。空を Incus の既定の 1 と読み、2 vCPU のテンプレートを 1 vCPU で固定してしまう
    if ! tcpu=$(inc config get --expanded "$SUITE_TEMPLATE/$SNAPSHOT" limits.cpu 2>/dev/null); then
      [[ -z $CPUS ]] || die "cannot read limits.cpu of $SUITE_TEMPLATE/$SNAPSHOT, which WGFT_LAB_CPUS needs to keep each VM's vCPU count"
      tcpu=""
    fi
  else
    tcpu=$CPU
  fi
  if [[ -n $CPUS ]]; then
    [[ -z $tcpu || $tcpu =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] \
      || die "cannot tell the vCPU count of the suite VMs from limits.cpu=$tcpu"
    per=$(vcpu_count "$tcpu")
    cpus_plan "$total" "$per"
    pins=("${CPU_PLAN[@]}")
    info "pinning $total suite VMs of $per vCPUs inside WGFT_LAB_CPUS=$CPUS: ${pins[*]}"
  elif [[ $tcpu =~ [,-] ]]; then
    info "note: the template's limits.cpu is the CPU set $tcpu, so every suite VM is pinned to those same CPUs; set WGFT_LAB_CPUS to give each VM its own CPUs"
  fi
  out=${out:-${TMPDIR:-/tmp}/wgft-lab-suite-$(date +%Y%m%d-%H%M%S)}
  mkdir -p "$out"
  out=$(cd "$out" && pwd)
  SUITE_T0=$SECONDS
  trap suite_cleanup EXIT
  trap 'info "interrupted; deleting the suite VMs"; exit 130' INT TERM HUP
  cmd_suite_gc
  # lifecycle.sh の check 5 と 5b が読む接続の枠の行は lab-observe の feature の build だけが書く。製品の build と
  # lab paired の build には付けない
  LAB_RUST_FEATURES=lab-observe host_build
  local k
  local names=() dirs=()
  for c in "${cfgs[@]}"; do
    for ((k = 1; k <= vms; k++)); do
      names+=("wgft-suite-$$-${c%/*}-${c#*/}-$k")
      dirs+=("$out/$c/shard-$k")
    done
  done
  SUITE_VMS=("${names[@]}")
  info "running on $total suite VMs: ${names[*]}; results in $out"
  i=0
  for c in "${cfgs[@]}"; do
    local ns=""
    [[ ${c#*/} == default ]] || ns=${c#*/}
    for ((k = 1; k <= vms; k++)); do
      SUITE_PIN=${pins[i]:-}
      suite_shard "${names[i]}" "${dirs[i]}" "$ns" "${c%/*}" "$k" "$vms" "$durations" "${dirs[@]}" &
      i=$((i + 1))
    done
  done
  wait
  # 終了コード:組ごとの失敗 (crc) を合わせる。rust の組は「UDP の中継」の段まで報告だけだった
  # (docs/development/testing.md の「マージの前に流すテスト」)。その段が入ったので SUITE_RUST_GATES を 1 にし、
  # go の組も流したときも rust の組の失敗を終了コードに入れる。rust の組だけを流したときは、その結果が終了コードになる
  local SUITE_RUST_GATES=1
  local rc=0 gosum="" crc rust_failed=0 has_go=0
  for c in "${cfgs[@]}"; do [[ ${c%/*} == go ]] && has_go=1; done
  for c in "${cfgs[@]}"; do
    echo
    echo "==== lab suite: agent=${c%/*}, netstack=${c#*/}, $vms VMs"
    crc=0
    local sums=()
    for ((k = 1; k <= vms; k++)); do
      local d=$out/$c/shard-$k ready ran src
      if [[ -f $d/times ]]; then
        read -r ready ran src < "$d/times"
        echo "shard $k/$vms: kernel $(cat "$d/kernel" 2>/dev/null), VM start and install ${ready} s, run ${ran} s, exit ${src}"
      else
        echo "shard $k/$vms: did not finish; see $d/shard.log"
      fi
      if [[ -f $d/summary.json ]]; then sums+=("$d/summary.json"); else crc=1; fi
    done
    # summary が欠けても、ある分を統合する。統合はどの shard でも流れなかった仕事を名前で出す。
    # rust の組は agent=go の仕事を流さないので、最初の go の組の統合からその結果を取って示す
    local from=()
    [[ ${c%/*} == rust && -n $gosum && -f $gosum ]] && from=(-go-summary "$gosum")
    if ((${#sums[@]})); then
      "$REPO/bin/labhost" merge -out "$out/$c" "${from[@]}" "${sums[@]}" || crc=1
    else
      echo "lab: nothing to merge for agent=${c%/*}, netstack=${c#*/}: no shard summary" >&2
      crc=1
    fi
    if ((crc)) && [[ ${c%/*} == rust ]] && ((has_go && !SUITE_RUST_GATES)); then
      rust_failed=1
    elif ((crc)); then
      rc=1
    fi
    [[ ${c%/*} == go && -z $gosum ]] && gosum=$out/$c/summary.json
  done
  echo
  if ((rust_failed)); then
    echo "lab: the rust configuration failed; it is report-only until the agent relays UDP, so the exit code leaves it out"
  fi
  echo "lab: suite wall time from the start to the merge: $((SECONDS - SUITE_T0)) s; VM deletion follows. Logs: $out"
  return $rc
}

# ---- lab paired:2 つの腕を 2 台の VM で同時に流し、round ごとに VM を入れ替えて byte あたりの CPU を比べる ----
# 腕は tcpquality.sh のモード (gvisor、wgstack、rust、userspace、kernel) か、--base の commit の build で流す
# base:<モード>。VM は lab suite と同じく WGFT_LAB_TEMPLATE のスナップショット clean の複製で、
# WGFT_LAB_PAIR_CPUS ("<VM a の集合> <VM b の集合>") があれば、各 VM の vCPU を集合の先頭の --vcpus 個に固定する。
# round ごとに 2 台が同時に lab/tcpquality-cpu.sh <経路> <モード> を SYNC=1 で流し、ホストが実行ごとに
# 2 台の始まりをそろえる。奇数の round は x が VM a、偶数の round は x が VM b で、2 台の CPU の差を打ち消す。
# 解析は tcpquality.py cpupaired。設計は docs/design/userspace/wgstack-performance.md の「CPU の比べ方」
#
# --split は agent を専用の VM に置く。腕ごとに VM を分けず、agent の VM (home の netns だけ) と相手の VM (client、vps、
# homerouter、lan) の 1 組を立て、2 つの腕を同じ組で交互に流す。奇数の round は x が先、偶数の round は y が先で、
# paired.log の vm=a は先に流れた腕、vm=b は後の腕を表す (解析は順の差を vm_a_over_b として打ち消す)。
# WGFT_LAB_PAIR_CPUS の 1 つ目の集合の先頭 --vcpus 個に agent の VM、2 つ目の集合の先頭 --peer-vcpus 個 (既定 8) に
# 相手の VM を固定する。2 台は Incus の専用のブリッジ (IP なし) で繋ぎ、agent の VM の NIC が home の eth0、相手の
# NIC が homerouter の lan0 になる (lab/netns.sh up-split-*)。カーネルモードの WireGuard は暗号の kworker を VM の
# 全 CPU に配るので、agent の CPU を分けるには VM を分けるしかない。相手の VM の tcpquality.sh は agent の VM の
# tcpquality.py agentd (incusbr0 の上、token 付き) を通して agent を操作する。Incus は vCPU のスレッドだけを固定し、
# vhost と qemu のほかのスレッドはホストの全 CPU に浮くので、ホストで tcpquality.py hostsample がそれらの時間と
# P コアに載った割合を記録し、解析の前に hostwin が実行ごとに足す
PAIRED_BASE_WT=""
PAIRED_SPLIT_NET=""
PAIRED_SAMPLER=""
PAIRED_AGENT_AT=""
PAIRED_OUT=""
paired_cleanup() {
  [[ -z $PAIRED_SAMPLER ]] || kill "$PAIRED_SAMPLER" 2>/dev/null || true
  # --cases:中断で終わった case と、まだ流していない case を cases.log に残す
  if [[ -n ${PAIRED_CASES_LOG:-} ]]; then
    [[ -z ${PAIRED_CASE_CUR:-} ]] || echo "CASE $PAIRED_CASE_CUR status=interrupted" >>"$PAIRED_CASES_LOG"
    [[ -z ${PAIRED_CASES_LEFT:-} ]] || sed 's/$/ status=not_run/; s/^/CASE /' <<<"$PAIRED_CASES_LEFT" >>"$PAIRED_CASES_LOG"
    PAIRED_CASE_CUR="" PAIRED_CASES_LEFT=""
  fi
  # --split:VM を消す前に、agent の VM の agent と agentd の log を出力先に写す。agentd の子は incus の agent の
  # PrivateTmp の /tmp に書くので、incus exec の /tmp からは見えず、agentd に頼んで読む。FAIL の原因を後で追うため
  if [[ -n $PAIRED_AGENT_AT && -n $PAIRED_OUT && -s $PAIRED_OUT/.agentd-token ]]; then
    paired_agent_logs "$PAIRED_OUT/agent-vm-logs.txt"
    rm -f "$PAIRED_OUT/.agentd-token"
  fi
  suite_cleanup || true
  if [[ -n $PAIRED_SPLIT_NET && -z ${SUITE_KEEP:-} ]]; then
    inc network delete "$PAIRED_SPLIT_NET" >/dev/null 2>&1 || info "could not delete the network $PAIRED_SPLIT_NET"
  fi
  if [[ -n $PAIRED_BASE_WT ]]; then
    git -C "$REPO" worktree remove --force "$PAIRED_BASE_WT" >/dev/null 2>&1 || true
  fi
}

# paired_agent_logs <file>:agent の VM の agentd と agent の log の末尾を file に写す
paired_agent_logs() {
  timeout 20 python3 "$REPO/lab/tcpquality.py" agentx "$PAIRED_AGENT_AT" "$PAIRED_OUT/.agentd-token" -- \
    sh -c 'for f in /tmp/wgft-agentd.log /tmp/wgft-tq-agent-*.log; do [ -f "$f" ] && { echo "==> $f"; tail -c 262144 "$f"; }; done' \
    >"$1" 2>&1 || info "could not copy the agent VM's logs"
}

# paired_build_base <ref> <rust 0|1>:ref の wgft を bin/base/ に、rust が 1 なら Rust の wgft を bin/base/rust/ に作る。
# ref は ~/.cache の一時的な worktree に取り出し、build の後すぐに消す。Go の build は lab build と同じく
# WGFT_LAB_BUILD_TAGS を付ける。Rust の target は ~/.cache/wgft-lab/paired-base-target に置き、作業ツリーの target に
# base の binary を残さない。この置き場は消さずに次の --base の build で依存を使い回す
# PAIRED_BASE_RUST_TARGET (--base-rust-target) は base の Rust の wgft の target で、既定は x86_64-unknown-linux-musl。
# x86_64-unknown-linux-gnu.2.41 のような glibc の target にすると、同じ commit の割り当て器と libc の違いを比べられる
paired_build_base() {
  local ref=$1 rust=$2 commit target=${PAIRED_BASE_RUST_TARGET:-x86_64-unknown-linux-musl}
  commit=$(git -C "$REPO" rev-parse --verify "$ref^{commit}") || die "--base $ref is not a commit"
  PAIRED_BASE_WT=${XDG_CACHE_HOME:-$HOME/.cache}/wgft-lab/paired-base-$$
  mkdir -p "$(dirname "$PAIRED_BASE_WT")"
  git -C "$REPO" worktree add -q --detach "$PAIRED_BASE_WT" "$commit" || die "cannot check out --base $ref"
  rm -rf "$REPO/bin/base"
  mkdir -p "$REPO/bin/base"
  (cd "$PAIRED_BASE_WT" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath ${WGFT_LAB_BUILD_TAGS:+-tags "$WGFT_LAB_BUILD_TAGS"} -o "$REPO/bin/base/" ./cmd/wgft) \
    || die "cannot build wgft of --base $ref"
  if ((rust)); then
    local tdir=${XDG_CACHE_HOME:-$HOME/.cache}/wgft-lab/paired-base-target
    mkdir -p "$tdir"
    # 置き場はすべての作業ツリーと実行で共有する。cargo の錠は build の後の install を覆わないので、build から
    # install までを置き場の flock で 1 つにし、同時の --base の build が互いの binary を入れないようにする
    (
      flock 9
      rust_build "$PAIRED_BASE_WT" "$target" "$REPO/bin/base/rust/wgft" "$tdir"
    ) 9>"$tdir.lock" || die "cannot build the Rust wgft of --base $ref for $target"
  fi
  git -C "$REPO" worktree remove --force "$PAIRED_BASE_WT" >/dev/null 2>&1 || true
  PAIRED_BASE_WT=""
  info "built --base $ref ($commit) into $REPO/bin/base/"
}

# paired_make_vm <name> <limits.cpu> <log>:VM を作り、build を入れる。2 台を同時に起こすと 1 台が上がらないことが
# あったので、失敗したら消して 1 回だけ作り直す
paired_make_vm() {
  local name=$1 pin=$2 log=$3 try
  for try in 1 2; do
    if (SUITE_PIN=$pin; suite_make_vm "$name" && vm_install && {
      [[ ! -f $REPO/bin/base/wgft ]] || in_vm sh -c 'rm -rf /usr/local/lib/wgft-base && install -D -m 0755 /wgft/bin/base/wgft /usr/local/lib/wgft-base/wgft && if [ -f /wgft/bin/base/rust/wgft ]; then install -D -m 0755 /wgft/bin/base/rust/wgft /usr/local/lib/wgft-base/rust/wgft; fi'
    }) >>"$log" 2>&1; then
      return 0
    fi
    echo "lab: VM $name did not come up, try $try" >>"$log"
    inc delete "$name" --force >/dev/null 2>&1 || true
  done
  return 1
}

# paired_offset <name>:VM の時計からホストの時計を引いた秒。VM の時計はホストから 1 秒ほどずれることがあり、
# 2 台の間でも違う (2026-11-01 の試し)。incus exec の往復の中点と比べ、3 回のうち往復の短い回の値を出す
paired_offset() {
  local i h0 v h1 best="" out=""
  for i in 1 2 3; do
    h0=$(date +%s.%N)
    v=$(timeout 30 bash -c "$(declare -f inc); inc exec $(printf %q "$1") -- date +%s.%N") || continue
    h1=$(date +%s.%N)
    out=$(awk -v h0="$h0" -v v="$v" -v h1="$h1" -v best="$best" -v out="$out" \
      'BEGIN { r = h1 - h0; if (best == "" || r < best) printf "%.6f %.4f", r, v - (h0 + h1) / 2; else printf "%s %s", best, out }')
    best=${out%% *} out=${out#* }
  done
  echo "${out:-0}"
}

# paired_sync <runs> <name a> <mode a> <log a> <pid a> <off a> <name b> <mode b> <log b> <pid b> <off b>:実行ごとに、
# 2 台が "SYNC ready" を出すか終わるまで待ち、待っている VM に PAIR_LEAD_S 秒先の始まりの時刻を、その VM の時計に
# 直して書く。片方が途中で終われば、残りの VM だけを放す。その実行は組にならず、解析が除く
paired_sync() {
  local runs=$1 k t side
  local -a names=("$2" "$7") modes=("$3" "$8") logs=("$4" "$9") pids=("$5" "${10}") offs=("$6" "${11}") ready w
  for ((k = 1; k <= runs; k++)); do
    while :; do
      ready=()
      for side in 0 1; do
        if grep -qx "SYNC ready mode=${modes[side]} run=$k" "${logs[side]}" 2>/dev/null; then
          ready+=("$side")
        elif kill -0 "${pids[side]}" 2>/dev/null; then
          ready=(wait)
          break
        fi
      done
      if [[ ${ready[0]:-} != wait ]]; then break; fi
      sleep 0.1
    done
    t=$(date +%s.%N)
    w=()
    for side in "${ready[@]}"; do
      inc exec "${names[side]}" -- sh -c "echo $(awk -v n="$t" -v l="$PAIR_LEAD_S" -v o="${offs[side]}" 'BEGIN { printf "%.3f", n + l + o }') > /tmp/wgft-tq-go-${modes[side]}-$k" &
      w+=($!)
    done
    if ((${#w[@]})); then wait "${w[@]}" || true; fi
  done
}

# lab paired の使い方。lab help と引数の誤りの両方がこの 1 つの文字列を出す
PAIRED_SYNOPSIS="paired [--rounds N] [--runs N] [--direction down|up] [--bytes N] [--tool tcpquality|iperf3] [--streams N] [--udp-ping] [--bulk-mbit N] [--agent-gso on|off] [--kernel-rmem-max BYTES] [--rust-target TRIPLE] [--base REF] [--base-rust-target TRIPLE] [--vcpus N] [--split [--peer-vcpus N] [--target lan|local] [--placement apart]] [--delay-ms MS [--delay-rate-mbit N] [--delay-queue-pkts N]] [--x-agent-env WGFT_NAME=VALUE] [--y-agent-env WGFT_NAME=VALUE] [--out DIR] [--keep] fast|rate|delay ARM_X ARM_Y, or with --split: paired --split [options] --cases FILE [--max-wall SECONDS] ARM_X ARM_Y"

# is_uint <値>:1 以上の整数か
is_uint() { [[ $1 =~ ^[1-9][0-9]*$ ]]; }
# require_uint <フラグ> <値> [<満たすべきものの言い方>]:1 以上の整数でなければ止まる
require_uint() { is_uint "$2" || die "$1 wants ${3:-a whole number of 1 or more}"; }

# 以下の paired_* は cmd_paired の local 変数を動的スコープで読み書きする (cmd_paired の先頭に宣言がある)

# paired_parse_args <引数...>:オプションを読み、残りの引数を rest に入れる
paired_parse_args() {
  while (($#)); do
    case $1 in
      --rounds) rounds=${2:?--rounds N}; shift 2 ;;
      --runs) runs=${2:?--runs N}; shift 2 ;;
      --direction) direction=${2:?--direction down|up}; shift 2 ;;
      --bytes) bytes=${2:?--bytes N}; shift 2 ;;
      --tool) tool=${2:?--tool tcpquality|iperf3}; shift 2 ;;
      --streams) streams=${2:?--streams N}; shift 2 ;;
      --udp-ping) udpping=1; shift ;;
      --bulk-mbit) bulkmbit=${2:?--bulk-mbit N}; shift 2 ;;
      --agent-gso) agentgso=${2:?--agent-gso on|off}; shift 2 ;;
      --kernel-rmem-max) rmemmax=${2:?--kernel-rmem-max BYTES}; shift 2 ;;
      --base) base=${2:?--base REF}; shift 2 ;;
      --rust-target) WGFT_LAB_RUST_TARGET=${2:?--rust-target TRIPLE}; rtarget_flag=1; shift 2 ;;
      --base-rust-target) PAIRED_BASE_RUST_TARGET=${2:?--base-rust-target TRIPLE}; shift 2 ;;
      --vcpus) vcpus=${2:?--vcpus N}; shift 2 ;;
      --split) split=1; shift ;;
      --peer-vcpus) peervcpus=${2:?--peer-vcpus N}; shift 2 ;;
      --target) target=${2:?--target lan|local}; shift 2 ;;
      --placement) placement=${2:?--placement apart}; shift 2 ;;
      --cases) cases=${2:?--cases FILE}; shift 2 ;;
      --max-wall) maxwall=${2:?--max-wall SECONDS}; shift 2 ;;
      --delay-ms) delayms=${2:?--delay-ms MS}; shift 2 ;;
      --delay-rate-mbit) delayrate=${2:?--delay-rate-mbit N}; shift 2 ;;
      --x-agent-env) xagentenv+=" ${2:?--x-agent-env WGFT_NAME=VALUE}"; shift 2 ;;
      --y-agent-env) yagentenv+=" ${2:?--y-agent-env WGFT_NAME=VALUE}"; shift 2 ;;
      --delay-queue-pkts) delayqueue=${2:?--delay-queue-pkts N}; shift 2 ;;
      --out) out=${2:?--out DIR}; shift 2 ;;
      --keep) keep=1; shift ;;
      -*) die "usage: lab $PAIRED_SYNOPSIS" ;;
      *) break ;;
    esac
  done
  rest=("$@")
}

# paired_validate <path> <arm x> <arm y>:オプションと腕を確かめ、path spec_x spec_y uses_base rust を決める
paired_validate() {
  (($# == 3)) || die "usage: lab $PAIRED_SYNOPSIS"
  path=$1 spec_x=$2 spec_y=$3
  local s m
  [[ $path == fast || $path == rate || $path == delay ]] || die "the path is fast, rate or delay; usage: lab $PAIRED_SYNOPSIS"
  [[ $path != delay ]] || { is_uint "$delayms" || die "the delay path wants --delay-ms, a whole number of ms each way"; }
  [[ -z $delayms || $path == delay ]] || die "--delay-ms goes with the delay path"
  [[ -z $delayrate && -z $delayqueue || $path == delay ]] || die "--delay-rate-mbit and --delay-queue-pkts go with the delay path"
  [[ -z $delayrate ]] || require_uint --delay-rate-mbit "$delayrate"
  local e
  for e in $xagentenv $yagentenv; do [[ $e =~ ^WGFT_[A-Z0-9_]+=[^[:space:]]*$ ]] || die "--x-agent-env and --y-agent-env want WGFT_NAME=VALUE; got $e"; done
  [[ -z $delayqueue ]] || require_uint --delay-queue-pkts "$delayqueue"
  [[ -z $peervcpus || -n $split ]] || die "--peer-vcpus goes with --split"
  [[ -z $target || ( -n $split && ( $target == lan || $target == local ) ) ]] || die "--target wants lan or local, with --split"
  [[ -z $placement || ( -n $split && $placement == apart ) ]] || die "--placement wants apart, with --split"
  # --placement apart は userspace の agent のプロセス全体を 1 つの CPU に置く。data plane が 1 スレッドの Rust の agent と、
  # 置くプロセスの無いカーネルモードだけに使える (gVisor の Go の agent や、暗号の worker を足した build には別の置き方が要る)
  local m
  for m in "${spec_x#base:}" "${spec_y#base:}"; do
    [[ -z $placement || $m == rust || $m == kernel ]] \
      || die "--placement apart pins the agent process to one CPU, which fits only an agent with one data-plane thread; arm $m is not rust or kernel"
  done
  local hp
  for hp in "${PAIRED_HOSTPOLL_X:-}" "${PAIRED_HOSTPOLL_Y:-}"; do
    [[ -z $hp || ( -n $split && ( $hp == on || $hp == off ) ) ]] || die "PAIRED_HOSTPOLL_X and PAIRED_HOSTPOLL_Y want on or off, with --split"
  done
  [[ ${PAIRED_HOSTPOLL_VMS:-both} =~ ^(agent|peer|both)$ ]] || die "PAIRED_HOSTPOLL_VMS wants agent, peer or both"
  [[ -z ${PAIRED_HOSTPOLL_X:-}${PAIRED_HOSTPOLL_Y:-} ]] || SUITE_NO_SECUREBOOT=1
  [[ -z ${PAIRED_KVM_SAMPLES:-} || -n $split ]] || die "PAIRED_KVM_SAMPLES goes with --split"
  [[ $target != local || ( $tool == iperf3 && -z $rmemmax ) ]] || die "--target local wants --tool iperf3 and no --kernel-rmem-max"
  [[ -z $peervcpus ]] || require_uint --peer-vcpus "$peervcpus"
  { is_uint "$rounds" && ((rounds % 2 == 0)); } || die "--rounds wants an even number, so that each arm runs as often in each VM"
  require_uint --runs "$runs"
  ((rounds / 2 * runs >= 2)) || die "--rounds $rounds with --runs $runs plans $((rounds / 2 * runs)) pair per side; the ratio needs at least 2 on each side, so raise --rounds or --runs"
  require_uint --vcpus "$vcpus"
  [[ $direction == down || $direction == up ]] || die "--direction wants down or up"
  [[ -z $bytes ]] || require_uint --bytes "$bytes" "a whole number of bytes"
  [[ -z $tool || $tool == tcpquality || $tool == iperf3 ]] || die "--tool wants tcpquality or iperf3"
  [[ -z $streams ]] || require_uint --streams "$streams"
  [[ -z $streams || $streams == 1 || $tool == iperf3 ]] || die "--streams above 1 needs --tool iperf3"
  [[ -z $udpping || $tool == iperf3 ]] || die "--udp-ping needs --tool iperf3"
  [[ -z $bulkmbit ]] || { is_uint "$bulkmbit" && [[ $tool == iperf3 ]]; } || die "--bulk-mbit wants a whole number of Mbit/s and --tool iperf3"
  [[ -z $agentgso || $agentgso == off || ( $agentgso == on && $path == fast ) ]] || die "--agent-gso wants off, or on with the fast path"
  [[ -z $rmemmax ]] || { is_uint "$rmemmax" && ((rmemmax >= 4096)); } || die "--kernel-rmem-max wants a whole number of bytes of 4096 or more"
  [[ -z $rmemmax || ${spec_x#base:} == kernel || ${spec_y#base:} == kernel ]] || die "--kernel-rmem-max sets the receiver of a kernel arm; neither arm is kernel"
  # 同じ腕は、--split でホストの halt polling だけを腕の間で替える比べ (PAIRED_HOSTPOLL_X と _Y が違う) に限る
  [[ $spec_x != "$spec_y" || ( -n $split && ${PAIRED_HOSTPOLL_X:-on} != "${PAIRED_HOSTPOLL_Y:-on}" ) ]] \
    || die "the two arms are the same: $spec_x; with --split, the same arm twice needs PAIRED_HOSTPOLL_X and PAIRED_HOSTPOLL_Y that differ"
  uses_base=0 rust=0
  for s in "$spec_x" "$spec_y"; do
    m=${s#base:}
    [[ $s != base:* ]] || uses_base=1
    case $m in
      gvisor | wgstack) ;;
      rust) rust=1 ;;
      # kernel は agent のプロセスが WireGuard と TCP を持たず、agent の byte あたりの CPU がほぼ 0 になる。
      # 比べられるのは VM 全体の byte あたりの CPU (VMRATIO) だけで、その値は測る道具の CPU も含むので、道具の CPU が
      # 小さい --tool iperf3 で流す。
      # userspace は gvisor と同じ
      kernel) [[ $tool == iperf3 ]] || die "arm $s: a kernel-mode agent spends almost no CPU in its process, so it is compared by the whole VM's CPU per byte only; use it with --tool iperf3" ;;
      userspace) die "arm $s: userspace runs the same agent as gvisor; name gvisor" ;;
      *) die "unknown arm $s; an arm is gvisor, wgstack, rust or, with --tool iperf3, kernel, or base:<one of them> with --base" ;;
    esac
  done
  ((!uses_base)) || [[ -n $base ]] || die "an arm base:<mode> needs --base REF"
  ((uses_base)) || [[ -z $base ]] || die "--base is given, but no arm is base:<mode>"
  [[ -z ${PAIRED_BASE_RUST_TARGET:-} || -n $base ]] || die "--base-rust-target needs --base REF"
  # --rust-target は作業ツリーの rust の腕だけに効く
  [[ -z $rtarget_flag || $spec_x == rust || $spec_y == rust ]] || info "warning: --rust-target has no effect: no arm runs the work tree's rust build"
}

# paired_plan_pins:VM ごとの固定を pins に入れる。WGFT_LAB_PAIR_CPUS の 2 つの集合の先頭から --vcpus 個ずつ。
# 無ければ固定せず、vCPU の数だけ決める
paired_plan_pins() {
  local sets=() used="" dup s
  pins=()
  if [[ -n ${WGFT_LAB_PAIR_CPUS:-} ]]; then
    read -ra sets <<<"$WGFT_LAB_PAIR_CPUS"
    ((${#sets[@]} == 2)) || die "WGFT_LAB_PAIR_CPUS='$WGFT_LAB_PAIR_CPUS' wants two CPU sets, one for each VM, like '16-23 8-15'"
    local want=("$vcpus" "$vcpus") k=0
    # --split:1 つ目の集合に agent の VM、2 つ目に相手の VM
    [[ -z $split ]] || want=("$vcpus" "${peervcpus:-8}")
    for s in "${sets[@]}"; do
      CPUS=$s
      cpus_expand
      ((${#CPU_LIST[@]} >= want[k])) || die "the CPU set $s of WGFT_LAB_PAIR_CPUS has ${#CPU_LIST[@]} CPUs, fewer than the ${want[k]} vCPUs of its VM"
      pins+=("$(cpus_join "${CPU_LIST[@]:0:want[k]}")")
      used+=" ${CPU_LIST[*]:0:want[k]}"
      k=$((k + 1))
    done
    CPUS=""
    dup=$(tr ' ' '\n' <<<"$used" | sed '/^$/d' | sort | uniq -d | head -1)
    [[ -z $dup ]] || die "the two VMs would share CPU $dup; give WGFT_LAB_PAIR_CPUS two sets that do not overlap"
  else
    pins=("$vcpus" "$vcpus")
    [[ -z $split ]] || pins=("$vcpus" "${peervcpus:-8}")
    info "note: WGFT_LAB_PAIR_CPUS is unset, so the two VMs are not pinned"
  fi
}

# paired_plan_line [<追加の key=value>]:paired.log の先頭の PLAN の行。--cases では case ごとに case_index と cases が付く
paired_plan_line() {
  echo "PLAN rounds=$rounds runs=$runs x=$spec_x y=$spec_y path=$path direction=$direction vcpus=$vcpus${delayms:+ delay_ms=$delayms}${delayrate:+ delay_rate_mbit=$delayrate}${delayqueue:+ delay_queue_pkts=$delayqueue}${xagentenv:+ x_agent_env=${xagentenv// /,}}${yagentenv:+ y_agent_env=${yagentenv// /,}}${split:+ split=1 peer_vcpus=${peervcpus:-8} target=${target:-lan}}${placement:+ placement=$placement}${1:+ $1}"
}

# paired_provision:出力先を作り、build して VM を 2 台立て、header.txt を書く。t0 と names、vms を決める
paired_provision() {
  local mk=() i kern dirty=""
  # 既定の出力先は ~/.cache の下。/tmp は RAM で、再起動で消える
  out=${out:-${XDG_CACHE_HOME:-$HOME/.cache}/wgft-lab/paired-$(date +%Y%m%d-%H%M%S)}
  mkdir -p "$out"
  out=$(cd "$out" && pwd)
  [[ -n $cases ]] || paired_plan_line >"$out/paired.log"
  SUITE_KEEP=$keep
  SUITE_TEMPLATE=${WGFT_LAB_TEMPLATE:-$VM}
  PAIR_LEAD_S=${PAIR_LEAD_S:-1}
  WGFT_LAB_AGENT_NETSTACK=""
  WGFT_LAB_AGENT_IMPL=""
  t0=$SECONDS
  SUITE_T0=$t0
  trap paired_cleanup EXIT
  trap 'info "interrupted; deleting the paired VMs"; exit 130' INT TERM HUP
  cmd_suite_gc
  if ((rust)); then LAB_BUILD_RUST=1; fi
  host_build
  if [[ -n $base ]]; then paired_build_base "$base" "$rust"; else rm -rf "$REPO/bin/base"; fi
  names=("wgft-paired-$$-a" "wgft-paired-$$-b")
  vms=(a b)
  if [[ -n $split ]]; then
    names=("wgft-split-$$-agent" "wgft-split-$$-peer")
    vms=(agent peer)
    # 同じ名前のネットワークは、前の実行が残したもの (PID の使い回し) で VM が繋がっていることがあるので使わない。
    # 名前を PAIRED_SPLIT_NET に入れる前に確かめ、片付けの trap が他人のネットワークを消さないようにする
    local net=wgftsp$$
    ! inc network show "$net" >/dev/null 2>&1 || die "the network $net exists already; delete it once no VM uses it"
    PAIRED_SPLIT_NET=$net
    # 作成が 60 秒戻らないことが、前の組がネットワークを消した直後に 2 度あった (2026-11-04、手で流すと 0.05 秒)。
    # 60 秒で切り、その間に作られていればそれを使い、無ければ 10 秒置いて 4 回まで流し直す。
    # timeout は関数を呼べないので、inc (sg incus-admin の経路を含む) を子の bash に渡す
    local try
    for try in 1 2 3 4; do
      timeout 60 bash -c "$(declare -f inc); inc network create $net ipv4.address=none ipv6.address=none" >/dev/null 2>&1 && break
      inc network show "$PAIRED_SPLIT_NET" >/dev/null 2>&1 && break
      ((try < 4)) || die "cannot create the network $PAIRED_SPLIT_NET"
      info "creating the network $PAIRED_SPLIT_NET did not finish in 60 s, try $try; trying again"
      sleep 10
    done
    SUITE_NIC_NET=$PAIRED_SPLIT_NET
  fi
  SUITE_VMS=("${names[@]}")
  # 2 台を少しずらして起こす。同時に起こした 2 台の片方が上がらないことがあった
  for i in 0 1; do
    if ((i)); then sleep "${PAIR_STAGGER_S:-5}"; fi
    paired_make_vm "${names[i]}" "${pins[i]}" "$out/vm-${vms[i]}.log" &
    mk+=($!)
  done
  for i in 0 1; do
    wait "${mk[i]}" || die "VM ${names[i]} did not come up in two tries; see $out/vm-${vms[i]}.log"
  done
  kern=$(VM=${names[0]}; in_vm uname -r)
  [[ -z $split ]] || paired_split_setup
  git -C "$REPO" diff --quiet HEAD 2>/dev/null || dirty=-dirty
  PAIRED_KERN=$kern PAIRED_DIRTY=$dirty PAIRED_READY_S=$((SECONDS - t0))
  if [[ -n $cases ]]; then
    echo "lab paired: ${#case_names[@]} cases in one VM pair; VMs ready after $PAIRED_READY_S s" | tee "$out/setup.txt"
  else
    paired_header | tee "$out/header.txt"
  fi
}

# paired_header:header.txt の行。--cases では case ごとに書き、VM の組を使い回したことを足す
paired_header() {
  local kern=$PAIRED_KERN dirty=$PAIRED_DIRTY
  {
    echo "lab paired: path $path, direction $direction, x=$spec_x y=$spec_y, $rounds rounds of $runs runs, tool ${tool:-tcpquality}, ${streams:-1} stream(s)${bulkmbit:+, capped at $bulkmbit Mbit/s per stream}${agentgso:+, agent UDP GSO $agentgso}${rmemmax:+, kernel receiver tcp_rmem max $rmemmax}${udpping:+, UDP round trips}"
    echo "lab paired: head $(git -C "$REPO" rev-parse HEAD)$dirty${base:+, base $(git -C "$REPO" rev-parse "$base^{commit}") ($base)}${WGFT_LAB_RUST_TARGET:+, head Rust target $WGFT_LAB_RUST_TARGET}${PAIRED_BASE_RUST_TARGET:+, base Rust target $PAIRED_BASE_RUST_TARGET}"
    if [[ -n $split ]]; then
      echo "lab paired: split: forwarding target ${target:-lan} (lan: a host on the LAN in the peer VM; local: on the agent's machine, over loopback)"
      echo "lab paired: split: agent VM ${names[0]} limits.cpu=${pins[0]} qemu $SPLIT_QEMU_AGENT, peer VM ${names[1]} limits.cpu=${pins[1]} qemu $SPLIT_QEMU_PEER, network $PAIRED_SPLIT_NET (taps$SPLIT_TAPS, queue ${PAIRED_TAP_QLEN:-4096}, NIC queues $SPLIT_PEER_Q), agentd $SPLIT_AGENT_AT, kernel $kern, template $SUITE_TEMPLATE"
      [[ -z ${PAIRED_HOSTPOLL_X:-}${PAIRED_HOSTPOLL_Y:-} ]] || echo "lab paired: split: host halt polling of the ${PAIRED_HOSTPOLL_VMS:-both} VM(s), set by the guests: x ${PAIRED_HOSTPOLL_X:-on}, y ${PAIRED_HOSTPOLL_Y:-on} (hostpoll= in paired.log)"
      [[ -z ${PAIRED_KVM_SAMPLES:-} ]] || echo "lab paired: split: KVM statistics from $PAIRED_KVM_SAMPLES (tcpquality.py kvmsample, started by root)"
      [[ -z $placement ]] || echo "lab paired: split: placement $placement: the data NIC's interrupts on CPU 0 of the agent VM, a userspace-mode agent on CPUs $SPLIT_AGENT_CPUS; the kernel mode has no agent process to place; peer VM: NIC interrupts on CPU 0, RPS on CPUs ${SPLIT_PEER_RPS:-unchanged}"
      echo "lab paired: split: the arms take turns in the same two VMs; vm=a in paired.log is the arm that ran first in the round. vhost and qemu's other threads are not pinned (host samples in host-samples.txt)"
    else
      echo "lab paired: VM a ${names[0]} limits.cpu=${pins[0]}, VM b ${names[1]} limits.cpu=${pins[1]}, kernel $kern, template $SUITE_TEMPLATE"
    fi
    echo "lab paired: VMs ready after $PAIRED_READY_S s"
  }
}

# paired_split_setup:--split の 2 台の netns を組み、agent の VM に agentd を立て、ホストの標本を始める
paired_split_setup() {
  local i mac nic token ip pid
  token=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
  for i in 0 1; do
    mac=$(inc config get "${names[i]}" volatile.eth1.hwaddr)
    [[ -n $mac ]] || die "VM ${names[i]} has no data NIC"
    nic=$(VM=${names[i]}; in_vm sh -c "ip -o link | awk -v m=$mac 'tolower(\$0) ~ m { sub(\":\", \"\", \$2); print \$2; exit }'")
    [[ -n $nic ]] || die "VM ${names[i]}: no interface with MAC $mac"
    (VM=${names[i]}; in_vm "$SHARE/lab/netns.sh" "$([[ $i == 0 ]] && echo up-split-agent || echo up-split-peer)" "$nic") >>"$out/vm-${vms[i]}.log" 2>&1 \
      || die "VM ${names[i]}: lab/netns.sh up-split failed; see $out/vm-${vms[i]}.log"
    (VM=${names[i]}; in_vm sh -c "umask 077; echo $token > /run/wgft-agentd.token")
  done
  # agentd は incusbr0 の上の agent の VM のアドレスで待つ。data の NIC は netns に移したので、root の netns の全体の
  # IPv4 アドレスは incusbr0 のものだけ
  ip=$(VM=${names[0]}; in_vm sh -c "ip -4 -o addr show scope global | awk '{ split(\$4, a, \"/\"); print a[1]; exit }'")
  [[ -n $ip ]] || die "VM ${names[0]} has no IPv4 address for agentd"
  (VM=${names[0]}; in_vm sh -c "setsid nohup python3 $SHARE/lab/tcpquality.py agentd $ip 7390 /run/wgft-agentd.token > /tmp/wgft-agentd.log 2>&1 < /dev/null &")
  SPLIT_AGENT_AT=$ip:7390
  # 後片付けで agent の VM の log を読むため、agentd の宛先と token を全体の変数と出力先 (0600) に残す
  PAIRED_AGENT_AT=$SPLIT_AGENT_AT PAIRED_OUT=$out
  (umask 077; echo "$token" > "$out/.agentd-token")
  local tries
  for tries in $(seq 1 50); do
    (VM=${names[1]}; in_vm python3 "$SHARE/lab/tcpquality.py" agentx "$SPLIT_AGENT_AT" /run/wgft-agentd.token -- true) >/dev/null 2>&1 && break
    sleep 0.2
  done
  (VM=${names[1]}; in_vm python3 "$SHARE/lab/tcpquality.py" agentx "$SPLIT_AGENT_AT" /run/wgft-agentd.token -- true) \
    || die "the peer VM cannot reach agentd at $SPLIT_AGENT_AT"
  (VM=${names[1]}; in_vm ip netns exec lan ping -c1 -W2 192.168.50.2) >/dev/null || die "the LAN host in the peer VM cannot reach home in the agent VM"
  # 2 台の NIC の queue を 1 組にする (PAIRED_AGENT_QUEUES、PAIRED_PEER_QUEUES で変えられる)。Incus の既定は vCPU の
  # 数の queue で、ホストの tap は flow の受信の queue を「ゲストがその flow を最後に送った queue」に振る。1 つの flow の
  # 受信が vCPU の間を行き来して順が崩れ、カーネルモードの TCP が SACK の reorder で再送した (2026-11-04: agent の
  # VM 2 vCPU、client の out-of-order 2500 から 2.8 万件/実行)。実機の NIC の RSS は flow を 1 つの queue に保つので、
  # queue は 1 組にして 1 つの flow が 1 つの queue に入る形で測る
  local q
  for i in 0 1; do
    if ((i)); then q=${PAIRED_PEER_QUEUES:-1}; else q=${PAIRED_AGENT_QUEUES:-1}; fi
    (VM=${names[i]}; in_vm ip netns exec "$([[ $i == 0 ]] && echo home || echo homerouter)" python3 "$SHARE/lab/tcpquality.py" channels "$([[ $i == 0 ]] && echo eth0 || echo lan0)" "$q") >>"$out/vm-${vms[i]}.log" 2>&1 \
      || die "cannot set the NIC of ${names[i]} to $q queue(s)"
  done
  SPLIT_PEER_Q="agent ${PAIRED_AGENT_QUEUES:-1}, peer ${PAIRED_PEER_QUEUES:-1}"
  # --placement apart:1 つの queue の割り込みと受信の softirq は 1 つの vCPU で走る。agent の data plane の 1 スレッドが
  # その vCPU に載るかをスケジューラが実行ごとに決め、載った実行だけが遅く byte あたりの CPU が多かった (2026-11-04、
  # 4 vCPU の受ける向きの A/A で 16 実行すべて)。data の NIC の全 vector を CPU 0 に固定し、userspace の agent を
  # CPU 1 だけに置いて、同居しない形にそろえる。CPU 1 から後の全部に置くと、8 vCPU でスレッドが 2 つの L2 の塊の間を
  # 移り、どちらの塊に載るかでも速さが数 % 揺れた。1 vCPU では agent も CPU 0。NIC の固定は VM の設定なので両方の腕に
  # 効き、カーネルモードには置くプロセスが無い (tqagent.sh は kernel の腕を固定しない)
  if [[ -n $placement ]]; then
    (VM=${names[0]}; in_vm ip netns exec home python3 "$SHARE/lab/tcpquality.py" nicirq eth0 0) >>"$out/vm-${vms[0]}.log" 2>&1 \
      || die "cannot put the data NIC's interrupts of ${names[0]} on CPU 0; see $out/vm-${vms[0]}.log"
    SPLIT_AGENT_CPUS=0
    ((vcpus == 1)) || SPLIT_AGENT_CPUS=1
    # 相手の VM:1 つの flow の受信の softirq は RPS が flow ごとに選ぶ 1 つの vCPU で走る。その vCPU が NIC の割り込みの
    # vCPU と重なった実行が詰まったので、NIC の全 vector を CPU 0 に固定し、全 veth の RPS から CPU 0 を外す
    local pv=${peervcpus:-8}
    if ((pv > 1)); then
      (VM=${names[1]}; in_vm ip netns exec homerouter python3 "$SHARE/lab/tcpquality.py" nicirq lan0 0) >>"$out/vm-${vms[1]}.log" 2>&1 \
        || die "cannot put the data NIC's interrupts of ${names[1]} on CPU 0; see $out/vm-${vms[1]}.log"
      (VM=${names[1]}; in_vm "$SHARE/lab/netns.sh" split-peer-rps "$(printf '%x' $(( (1 << pv) - 2 )))") >>"$out/vm-${vms[1]}.log" 2>&1 \
        || die "cannot narrow RPS in ${names[1]}; see $out/vm-${vms[1]}.log"
      SPLIT_PEER_RPS="1-$((pv - 1))"
    fi
  fi
  # 2 台の idle の仕方と data の NIC の形を 1 度だけ残す (ホストでの時間の内訳を読むときに要る)
  for i in 0 1; do
    { echo "VM ${vms[i]} ${names[i]}"
      (VM=${names[i]}; in_vm ip netns exec "$([[ $i == 0 ]] && echo home || echo homerouter)" python3 "$SHARE/lab/tcpquality.py" guestinfo "$([[ $i == 0 ]] && echo eth0 || echo lan0)") 2>&1
    } >>"$out/guestinfo.txt"
  done
  if [[ -z $cases && $target == local ]]; then
    # --target local:転送先を agent のマシンに置く。LAN のホストのアドレスを agent の VM の home の lo に移し、
    # 相手の VM の lan の netns からは外す。agent は転送先へ loopback で繋ぎ、転送先の CPU は agent の VM に入る
    (VM=${names[1]}; in_vm ip -n lan addr flush dev eth0) || die "cannot remove the LAN host's address in the peer VM"
    (VM=${names[0]}; in_vm ip -n home addr add 192.168.50.3/32 dev lo) || die "cannot put the LAN host's address on home's lo"
  fi
  for i in 0 1; do
    pid=$(pgrep -f "qemu-system.*${names[i]}" | head -1)
    [[ -n $pid ]] || die "no qemu process for ${names[i]}"
    if ((i)); then SPLIT_QEMU_PEER=$pid; else SPLIT_QEMU_AGENT=$pid; fi
  done
  SPLIT_TAPS=""
  for i in 0 1; do SPLIT_TAPS+=" tap:${vms[i]}=$(inc config get "${names[i]}" volatile.eth1.host_name)"; done
  if [[ -n $cases ]]; then
    # --cases:case の間に戻す値 (namespace ごとの TCP のバッファの sysctl) を記録する。標本は case ごとに始める
    for i in 0 1; do
      (VM=${names[i]}; in_vm bash "$SHARE/lab/splitcase.sh" save) >>"$out/vm-${vms[i]}.log" 2>&1 \
        || die "cannot record the state of ${names[i]} for --cases; see $out/vm-${vms[i]}.log"
    done
  else
    paired_start_sampler
  fi
}

# paired_start_sampler:ホストの標本を $out/host-samples.txt に始める
paired_start_sampler() {
  # shellcheck disable=SC2086 # the two tap specs are words on purpose
  # --lab-pid:この lab が SIGKILL で消えても、標本は自分で止まる (suite-gc もこの印で探す)
  python3 "$REPO/lab/tcpquality.py" hostsample "$out/host-samples.txt" 0.5 "agent=$SPLIT_QEMU_AGENT" "peer=$SPLIT_QEMU_PEER" $SPLIT_TAPS "--lab-pid=$$" &
  PAIRED_SAMPLER=$!
}

# paired_run_split_round <r>:--split の round r。2 つの腕を相手の VM で順に流す。奇数の round は x が先
paired_run_split_round() {
  local r=$1 k spec mode log off cur_arm
  local arms=(x y) env=()
  ((r % 2)) || arms=(y x)
  off=$(paired_offset "${names[1]}")
  for k in 0 1; do
    spec=${spec_of[${arms[k]}]}
    mode=${spec#base:}
    paired_hostpoll "${arms[k]}"
    env=(RUNS="$runs" DIRECTION="$direction" AGENT_AT="$SPLIT_AGENT_AT")
    [[ $target != local ]] || env+=(TARGET_LOCAL=1)
    [[ -z $SPLIT_AGENT_CPUS ]] || env+=(AGENT_CPUS="$SPLIT_AGENT_CPUS")
    cur_arm=${arms[k]}
    paired_round_env
    log=$out/round-$r-${arms[k]}.log
    # 後ろで流して wait で待つ。前で流すと、TERM の trap が arm の終わり (最長 run_timeout) まで待たされる
    (VM=${names[1]}; suite_timeout "$run_timeout" in_vm env "${env[@]}" bash "$SHARE/lab/tcpquality-cpu.sh" "$path" "$mode") >"$log" 2>&1 &
    local arm_rc=0
    wait $! || arm_rc=$?
    ((arm_rc == 0)) || rc=1
    # --cases:時間切れ (timeout の 124、-k の 137) か agentd に届かなかった arm の後は、VM の組を確かめ直す
    if [[ -n $cases ]] && { ((arm_rc == 124 || arm_rc == 137)) || grep -q '^agentx: ' "$log"; }; then
      PAIRED_CASE_SUSPECT=1
    fi
    if grep -q '^FAIL' "$log"; then
      grep '^FAIL' "$log" | sed "s/^/round $r arm ${arms[k]}: /"
      fails=1
    fi
    { grep '^RESULT ' "$log" || true; } \
      | sed "s/^RESULT /PAIRED round=$r vm=${vms_order[k]} arm=${arms[k]} name=$spec clock_offset_s=$off${SPLIT_HOSTPOLL:+ hostpoll=$SPLIT_HOSTPOLL} /" \
      | awk -v o="$off" '{ for (i = 1; i <= NF; i++) if ($i ~ /^t_(start|end)=/) { split($i, kv, "="); $i = sprintf("%s=%.3f", kv[1], kv[2] - o) } print }' >>"$out/paired.log"
  done
  echo "lab paired: round $r of $rounds done, ${arms[0]} first, $((SECONDS - t0)) s"
}

# paired_hostpoll <arm>:PAIRED_HOSTPOLL_X、PAIRED_HOSTPOLL_Y (on か off、片方だけなら他方は on) があれば、その腕の前に
# PAIRED_HOSTPOLL_VMS (agent、peer、both、既定 both) の VM のホストの halt polling を入れるか切る。ゲストの root が
# MSR_KVM_POLL_CONTROL を書くので、ホストの設定は変わらず、VM を消せば元に戻る。腕の行に hostpoll= を付ける
paired_hostpoll() {
  local want i vm
  SPLIT_HOSTPOLL=""
  [[ -n ${PAIRED_HOSTPOLL_X:-}${PAIRED_HOSTPOLL_Y:-} ]] || return 0
  # 片方だけ指定したときは、もう片方の腕を on に戻す (前の腕の設定を引き継がない)
  if [[ $1 == x ]]; then want=${PAIRED_HOSTPOLL_X:-on}; else want=${PAIRED_HOSTPOLL_Y:-on}; fi
  for i in 0 1; do
    vm=$([[ $i == 0 ]] && echo agent || echo peer)
    [[ ${PAIRED_HOSTPOLL_VMS:-both} == both || ${PAIRED_HOSTPOLL_VMS:-both} == "$vm" ]] || continue
    (VM=${names[i]}; suite_timeout 60 in_vm sh -c "modprobe msr && python3 $SHARE/lab/tcpquality.py pollctl $want") >>"$out/vm-${vms[i]}.log" 2>&1 \
      || die "cannot turn the host's halt polling $want for the $vm VM; see $out/vm-${vms[i]}.log"
  done
  SPLIT_HOSTPOLL="$want:${PAIRED_HOSTPOLL_VMS:-both}"
}

# paired_round_env:spec と mode の腕の tcpquality.sh の環境を env に足す (2 つの round の流し方で共通)
paired_round_env() {
  [[ -z $bytes ]] || env+=(BYTES="$bytes")
  [[ -z $tool ]] || env+=(TOOL="$tool")
  [[ -z $streams ]] || env+=(STREAMS="$streams")
  [[ -z $udpping ]] || env+=(UDPPING=1)
  [[ -z $bulkmbit ]] || env+=(IPERF_MBIT="$bulkmbit")
  [[ -z $agentgso ]] || env+=(AGENT_GSO="$agentgso")
  [[ -z $rmemmax || $mode != kernel ]] || env+=(KERNEL_RMEM_MAX="$rmemmax")
  [[ $spec != base:* ]] || env+=(WGFT_BIN_DIR=/usr/local/lib/wgft-base)
  # 遅れのある経路:netem の待ち行列は tcpquality.sh が遅れから決め、カーネルの TCP の端のバッファは 64 MiB まで許す
  [[ $path != delay ]] || env+=(DELAY_MS="$delayms" TCP_BUF_MAX="${PAIRED_TCP_BUF_MAX:-67108864}")
  [[ -z $delayrate ]] || env+=(DELAY_RATE_MBIT="$delayrate")
  # --x-agent-env / --y-agent-env: extra agent environment for one arm (an experimental opt-in setting)
  local extra
  if [[ $cur_arm == x ]]; then extra=$xagentenv; else extra=$yagentenv; fi
  [[ -z ${extra// /} ]] || env+=(AGENT_EXTRA_ENV="${extra# }")
  [[ -z $delayqueue ]] || env+=(DELAY_QUEUE_PKTS="$delayqueue")
}

# paired_run_round <r>:round r を 2 台で同時に流し、結果の行を paired.log に足す。rc と fails と prev_offs を更新する
paired_run_round() {
  local r=$1 side spec mode cur_arm
  local arms=(x y) logs=() pids=() modes=() env=() offs=()
  ((r % 2)) || arms=(y x)
  for side in 0 1; do
    offs+=("$(paired_offset "${names[side]}")")
    # 時計の差が round の間に 50 ms を超えて動けば、始まりの同期がその分ずれうるので知らせる
    if [[ -n ${prev_offs[side]:-} ]] && awk -v a="${prev_offs[side]}" -v b="${offs[side]}" 'BEGIN { d = a - b; exit !(d > 0.05 || d < -0.05) }'; then
      echo "lab paired: warning: the clock of VM ${vms[side]} moved from ${prev_offs[side]} s to ${offs[side]} s off the host since the last round"
    fi
  done
  prev_offs=("${offs[@]}")
  for side in 0 1; do
    spec=${spec_of[${arms[side]}]}
    mode=${spec#base:}
    env=(SYNC=1 RUNS="$runs" DIRECTION="$direction")
    cur_arm=${arms[side]}
    paired_round_env
    logs+=("$out/round-$r-${vms[side]}.log")
    modes+=("$mode")
    (VM=${names[side]}; suite_timeout "$run_timeout" in_vm env "${env[@]}" bash "$SHARE/lab/tcpquality-cpu.sh" "$path" "$mode") >"${logs[side]}" 2>&1 &
    pids+=($!)
  done
  paired_sync "$runs" "${names[0]}" "${modes[0]}" "${logs[0]}" "${pids[0]}" "${offs[0]}" "${names[1]}" "${modes[1]}" "${logs[1]}" "${pids[1]}" "${offs[1]}"
  for side in 0 1; do
    wait "${pids[side]}" || rc=1
    if grep -q '^SYNC go .* wait_s=-' "${logs[side]}"; then
      echo "lab paired: warning: round $r VM ${vms[side]}: $(grep -c '^SYNC go .* wait_s=-' "${logs[side]}") runs got the start time after it had passed"
    fi
    if grep -q '^FAIL' "${logs[side]}"; then
      grep '^FAIL' "${logs[side]}" | sed "s/^/round $r VM ${vms[side]}: /"
      fails=1
    fi
    # 窓の時刻は VM の時計なので、ホストの時計に直して 2 台の窓の重なりを比べられるようにする
    { grep '^RESULT ' "${logs[side]}" || true; } \
      | sed "s/^RESULT /PAIRED round=$r vm=${vms[side]} arm=${arms[side]} name=${spec_of[${arms[side]}]} clock_offset_s=${offs[side]} /" \
      | awk -v o="${offs[side]}" '{ for (i = 1; i <= NF; i++) if ($i ~ /^t_(start|end)=/) { split($i, kv, "="); $i = sprintf("%s=%.3f", kv[1], kv[2] - o) } print }' >>"$out/paired.log"
  done
  echo "lab paired: round $r of $rounds done, x in VM $([[ ${arms[0]} == x ]] && echo a || echo b), $((SECONDS - t0)) s"
}

# paired_run_timeout:1 つの round の上限 run_timeout。起動と後片付けに 300 秒、実行ごとに転送の時間 (fast は 100 Mbit/s、
# rate は経路の 20 Mbit/s で見積もる) と 60 秒の余裕。既定の fast は約 740 秒、rate は約 520 秒
paired_run_timeout() {
  run_timeout=$(awk -v b="${bytes:-$([[ $path == rate ]] && echo 33554432 || echo 1073741824)}" -v r="$runs" \
    -v bps="$([[ $path == rate ]] && echo 20000000 || echo 100000000)" 'BEGIN { printf "%d", 300 + r * (b * 8 / bps + 60) }')
}

# paired_report:paired.log を解析して result.txt を作り、表示する
paired_report() {
  if [[ -n $PAIRED_SAMPLER ]]; then
    kill "$PAIRED_SAMPLER" 2>/dev/null || true
    PAIRED_SAMPLER=""
    python3 "$REPO/lab/tcpquality.py" hostwin "$out/host-samples.txt" "$out/paired.log" "${PAIRED_KVM_SAMPLES:-}" || rc=1
  fi
  python3 "$REPO/lab/tcpquality.py" cpupaired "$out/paired.log" >"$out/result.txt" || rc=1
  if [[ -n $udpping ]]; then
    python3 "$REPO/lab/tcpquality.py" latpaired "$out/paired.log" >>"$out/result.txt" || rc=1
  fi
  cat "$out/result.txt"
  ((!fails)) || rc=1
  if [[ -n $cases ]]; then
    echo "lab paired: case wall time $((SECONDS - t_case)) s; logs in $out"
  else
    echo "lab paired: wall time $((SECONDS - t0)) s before deleting the VMs; logs in $out"
  fi
}

# ---- lab paired --split --cases FILE:1 組の VM で複数の case を順に流す ----
# split の 1 case のうち測るのは約 3 分で、残りの約 2.5 分は VM 2 台の作成、起動、build の導入と削除だった。--cases は
# その固定の費用を case の数で割る。FILE の 1 行が 1 case で、`<名前> <経路> [case ごとのフラグ...]` と書く (# から後と
# 空行は読まない)。case ごとに変えられるのは VM の組を作り直さずに済むもの (PAIRED_CASE_FLAGS) だけで、VM の形を決める
# もの (--vcpus、--peer-vcpus、--placement、--base、腕、--x-agent-env など) はコマンド行で全 case に共通に与える。
# コマンド行の case ごとのフラグは全 case の既定になる。case ごとの出力は --out/<名前>/ に今と同じ形 (PLAN の行のある
# paired.log、header.txt、result.txt、host-samples.txt、round ごとのログ) で置き、PLAN の行に case_index と cases、
# header.txt に使い回しの行を足す。case の前に両方の VM を splitcase.sh で戻し (残ったプロセス、netem、TCP の
# バッファの sysctl)、--target の置き場所を合わせ、agentd と LAN の疎通を確かめる。失敗した case は次の case を
# 止めず、VM の組が戻らないときだけ残りを流さない
PAIRED_CASE_FLAGS="--direction --bytes --tool --streams --udp-ping --bulk-mbit --agent-gso --kernel-rmem-max --delay-ms --delay-rate-mbit --delay-queue-pkts --target --rounds --runs"
PAIRED_CASE_VARS="direction bytes tool streams udpping bulkmbit agentgso rmemmax delayms delayrate delayqueue target rounds runs"

# paired_cases_read:FILE を読み、case_names、case_paths、case_flags に入れる
paired_cases_read() {
  local line ln=0 words=() n seen=" "
  [[ -f $cases && -r $cases ]] || die "--cases $cases is not a readable file"
  while IFS= read -r line || [[ -n $line ]]; do
    ln=$((ln + 1))
    line=${line%%#*}
    read -ra words <<<"$line"
    ((${#words[@]})) || continue
    ((${#words[@]} >= 2)) || die "--cases $cases line $ln: want <name> <path> [flags...]"
    n=${words[0]}
    # 点を許さないので、--out の直下のファイル (setup.txt、cases.log、vm-*.log、guestinfo.txt) と名前がぶつからない
    [[ $n =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "--cases $cases line $ln: the name $n wants letters, digits, dash or underscore only"
    [[ $seen != *" $n "* ]] || die "--cases $cases line $ln: the name $n is used twice"
    seen+="$n "
    case_names+=("$n") case_paths+=("${words[1]}") case_flags+=("${words[*]:2}")
  done <"$cases"
  ((${#case_names[@]})) || die "--cases $cases has no case"
}

# paired_case_load <i>:case i のフラグを、コマンド行の値 (case_defaults) の上に読む
paired_case_load() {
  local v f=() where="--cases $cases case ${case_names[$1]}"
  for v in $PAIRED_CASE_VARS; do printf -v "$v" '%s' "${case_defaults[$v]}"; done
  read -ra f <<<"${case_flags[$1]}"
  while ((${#f[@]})); do
    if [[ ${f[0]} == --udp-ping ]]; then
      udpping=1 f=("${f[@]:1}")
      continue
    fi
    [[ " $PAIRED_CASE_FLAGS " == *" ${f[0]} "* ]] \
      || die "$where: ${f[0]} is not a per-case flag; give it on the command line, the same for every case; the per-case flags are $PAIRED_CASE_FLAGS"
    ((${#f[@]} >= 2)) || die "$where: ${f[0]} wants a value"
    case ${f[0]} in
      --direction) direction=${f[1]} ;;
      --bytes) bytes=${f[1]} ;;
      --tool) tool=${f[1]} ;;
      --streams) streams=${f[1]} ;;
      --bulk-mbit) bulkmbit=${f[1]} ;;
      --agent-gso) agentgso=${f[1]} ;;
      --kernel-rmem-max) rmemmax=${f[1]} ;;
      --delay-ms) delayms=${f[1]} ;;
      --delay-rate-mbit) delayrate=${f[1]} ;;
      --delay-queue-pkts) delayqueue=${f[1]} ;;
      --target) target=${f[1]} ;;
      --rounds) rounds=${f[1]} ;;
      --runs) runs=${f[1]} ;;
    esac
    f=("${f[@]:2}")
  done
}

# paired_case_prepare:case の前に 2 台を戻し、--target を合わせ、使えるかを確かめる。戻らなければ 1
paired_case_prepare() {
  local i want=${target:-lan}
  # 相手の VM を先に戻す。その tcpquality の残りが agent の VM を操作し続けないように
  for i in 1 0; do
    (VM=${names[i]}; suite_timeout 120 in_vm bash "$SHARE/lab/splitcase.sh" reset) >>"$top/vm-${vms[i]}.log" 2>&1 &
    wait $! || { echo "lab paired: cannot reset ${names[i]}; see $top/vm-${vms[i]}.log"; return 1; }
  done
  if [[ $want != "$SPLIT_CUR_TARGET" ]]; then
    for i in 0 1; do
      (VM=${names[i]}; suite_timeout 60 in_vm bash "$SHARE/lab/splitcase.sh" target "$want") >>"$top/vm-${vms[i]}.log" 2>&1 \
        || { echo "lab paired: cannot move the forwarding target to $want in ${names[i]}"; return 1; }
    done
    SPLIT_CUR_TARGET=$want
  fi
  (VM=${names[1]}; suite_timeout 60 in_vm python3 "$SHARE/lab/tcpquality.py" agentx "$SPLIT_AGENT_AT" /run/wgft-agentd.token -- true) >/dev/null 2>&1 \
    || { echo "lab paired: the peer VM cannot reach agentd at $SPLIT_AGENT_AT"; return 1; }
  if [[ $want == lan ]]; then
    (VM=${names[1]}; suite_timeout 60 in_vm ip netns exec lan ping -c1 -W2 192.168.50.2) >/dev/null 2>&1 \
      || { echo "lab paired: the LAN host in the peer VM cannot reach home in the agent VM"; return 1; }
  fi
  return 0
}

# paired_cases_main:--cases の全体。全 case を VM を立てる前に確かめ、1 組の VM を立て、case を順に流す。
# wgft-heavy の測定の job は 60 分で切られ、切られると後片付け (paired_cleanup) が走らずに VM が残る。--max-wall
# (PAIRED_MAX_WALL_S、既定 3300 秒) は t0 (build の前) からの上限で、各 case の前に、経過と見積もり (流し終えた case の
# 実行 1 回あたりの最長の時間 × この case の実行の数 × 1.2) が上限を超える case から後を流さない。最初の case は
# 見積もりの元が無いので、上限の残りがあれば流す (run_timeout は詰まりの上限で、実際の時間の 10 倍近い)
PAIRED_CASE_CUR="" PAIRED_CASES_LOG="" PAIRED_CASES_LEFT=""
paired_cases_main() {
  local i n v top all_rc=0 path0 budget est per_run=0 runs_now k
  [[ -n $split ]] || die "--cases goes with --split"
  ((${#rest[@]} == 2)) || die "with --cases, give the two arms only: lab paired --split [options] --cases FILE ARM_X ARM_Y"
  budget=${maxwall:-${PAIRED_MAX_WALL_S:-3300}}
  is_uint "$budget" || die "--max-wall wants a whole number of seconds"
  paired_cases_read
  n=${#case_names[@]}
  for v in $PAIRED_CASE_VARS; do case_defaults[$v]=${!v}; done
  # すべての case を VM を立てる前に確かめる。どの case の誤りかを言うため、1 つずつ subshell で確かめる
  for ((i = 0; i < n; i++)); do
    (paired_case_load "$i" && paired_validate "${case_paths[i]}" "${rest[@]}") \
      || die "--cases $cases case ${case_names[i]}: see the message above"
  done
  paired_case_load 0
  path0=${case_paths[0]}
  paired_validate "$path0" "${rest[@]}"
  paired_plan_pins
  paired_provision
  top=$out
  PAIRED_CASES_LOG=$top/cases.log
  : >"$PAIRED_CASES_LOG"
  for ((i = 0; i < n; i++)); do
    paired_case_load "$i"
    paired_validate "${case_paths[i]}" "${rest[@]}"
    runs_now=$((rounds * runs * 2))
    est=$(awk -v p="$per_run" -v r="$runs_now" 'BEGIN { printf "%d", p * r * 1.2 }')
    if ((SECONDS - t0 + est > budget)); then
      echo "lab paired: case $((i + 1)) of $n ${case_names[i]} would end after the wall budget: $((SECONDS - t0)) s so far, about $est s more, budget $budget s; it and the cases after it are not run"
      paired_cases_mark "$i" not_run
      all_rc=1
      break
    fi
    out=$top/${case_names[i]}
    mkdir -p "$out"
    rc=0 fails=0 prev_offs=() t_case=$SECONDS
    PAIRED_CASE_CUR="index=$((i + 1)) name=${case_names[i]}"
    PAIRED_CASES_LEFT=$(for ((k = i + 1; k < n; k++)); do echo "index=$((k + 1)) name=${case_names[k]}"; done)
    if ! paired_case_prepare; then
      echo "lab paired: the VM pair did not come back before case $((i + 1)) of $n ${case_names[i]}; the remaining cases are not run"
      paired_cases_mark "$i" not_run
      all_rc=1
      break
    fi
    paired_plan_line "case_index=$((i + 1)) cases=$n" >"$out/paired.log"
    {
      paired_header
      echo "lab paired: case $((i + 1)) of $n ${case_names[i]} of --cases $cases: the VM pair was set up once for all cases and reused; cases run in it before this one: $i"
    } | tee "$out/header.txt"
    cp "$top/guestinfo.txt" "$out/guestinfo.txt" 2>/dev/null || true
    # agentd の log に case の境を書き、agent-vm-logs.txt を case ごとに切れるようにする
    timeout 20 python3 "$REPO/lab/tcpquality.py" agentx "$PAIRED_AGENT_AT" "$PAIRED_OUT/.agentd-token" -- \
      sh -c "echo '== lab paired case $((i + 1)) of $n ${case_names[i]} starts' >> /tmp/wgft-agentd.log" >/dev/null 2>&1 || true
    paired_start_sampler
    paired_run_timeout
    local -A spec_of=([x]=$spec_x [y]=$spec_y)
    local healthy=1
    for ((r = 1; r <= rounds; r++)); do
      PAIRED_CASE_SUSPECT=""
      paired_run_split_round "$r"
      if [[ -n $PAIRED_CASE_SUSPECT ]] && ! paired_case_prepare; then
        echo "lab paired: after a timed-out arm or an unreachable agentd in round $r, the VM pair did not come back; case $((i + 1)) ends here and the remaining cases are not run"
        healthy=0 rc=1
        break
      fi
    done
    paired_report
    paired_agent_logs "$out/agent-vm-logs.txt"
    echo "CASE $PAIRED_CASE_CUR status=$([[ $rc == 0 ]] && echo pass || echo fail) wall_s=$((SECONDS - t_case))" >>"$PAIRED_CASES_LOG"
    PAIRED_CASE_CUR=""
    ((rc == 0)) || all_rc=1
    k=$(awk -v w="$((SECONDS - t_case))" -v r="$runs_now" -v p="$per_run" 'BEGIN { v = w / r; printf "%.3f", (v > p ? v : p) }')
    per_run=$k
    if ((!healthy)); then
      paired_cases_mark "$((i + 1))" not_run
      break
    fi
  done
  PAIRED_CASES_LEFT=""
  out=$top
  echo "lab paired: cases:"
  cat "$PAIRED_CASES_LOG"
  echo "lab paired: wall time $((SECONDS - t0)) s for $n cases before deleting the VMs; logs in $top"
  rc=$all_rc
}

# paired_cases_mark <i> <status>:case i から後をすべて status として cases.log に書く
paired_cases_mark() {
  local k
  for ((k = $1; k < ${#case_names[@]}; k++)); do echo "CASE index=$((k + 1)) name=${case_names[k]} status=$2" >>"$PAIRED_CASES_LOG"; done
}

cmd_paired() {
  local rounds=4 runs=3 base="" out="" keep="" vcpus=4 direction=down bytes="" tool="" streams="" udpping="" bulkmbit="" agentgso="" rmemmax="" rtarget_flag=""
  local split="" peervcpus="" delayms="" delayrate="" delayqueue="" target="" placement="" SPLIT_AGENT_CPUS="" SPLIT_PEER_RPS="" xagentenv="" yagentenv="" SPLIT_HOSTPOLL="" SPLIT_TAPS="" SPLIT_PEER_Q="" SPLIT_AGENT_AT="" SPLIT_QEMU_AGENT="" SPLIT_QEMU_PEER="" vms_order=(a b)
  local rest=() path spec_x spec_y uses_base rust pins=() names=() vms=() t0 run_timeout r
  local rc=0 fails=0 prev_offs=()
  local cases="" maxwall="" case_names=() case_paths=() case_flags=() PAIRED_KERN="" PAIRED_DIRTY="" PAIRED_READY_S="" SPLIT_CUR_TARGET=lan
  local PAIRED_CASE_SUSPECT="" t_case=""
  local -A case_defaults=()
  paired_parse_args "$@"
  if [[ -n $cases ]]; then
    paired_cases_main
    return $rc
  fi
  paired_validate "${rest[@]}"
  paired_plan_pins
  paired_provision
  paired_run_timeout
  local -A spec_of=([x]=$spec_x [y]=$spec_y)
  for ((r = 1; r <= rounds; r++)); do
    if [[ -n $split ]]; then paired_run_split_round "$r"; else paired_run_round "$r"; fi
  done
  paired_report
  return $rc
}

# lab test <pkg> [ns] [go test flags...]:ホストで build tag lab 付きのテストバイナリを作り、VM の ns(既定 vps)で実行する
cmd_test() {
  [[ $# -ge 1 ]] || die "usage: lab test <pkg> [ns] [-test.run ...]"
  local pkg=${1%/}; shift
  local ns=vps
  if [[ $# -ge 1 && $1 != -* ]]; then ns=$1; shift; fi
  local name="$(basename "$pkg").test"
  (cd "$REPO" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go test -c -tags lab -o "bin/$name" "./$pkg") || die "テストのビルドに失敗"
  ensure_running
  in_vm ip netns exec "$ns" sh -c "cd $SHARE/$pkg && exec $SHARE/bin/$name -test.v $(printf '%q ' "$@")"
}

cmd_status() {
  if ! vm_exists; then echo "VM '$VM': absent"; return; fi
  echo "VM '$VM': $(vm_state)"
  echo "snapshot '$SNAPSHOT': $(has_snapshot && echo present || echo absent)"
  [[ $(vm_state) == RUNNING ]] || return 0
  inc exec "$VM" -- bash -s <<EOF
mountpoint -q $SHARE && echo "share $SHARE: mounted" || echo "share $SHARE: NOT mounted"
test -f /var/lib/wgft-lab/provisioned && echo "provisioned: yes" || echo "provisioned: no"
echo "kernel: \$(uname -r)"
getent hosts deb.debian.org >/dev/null && echo "dns: ok" || echo "dns: NG"
ping -4 -c1 -W2 1.1.1.1 >/dev/null 2>&1 && echo "ipv4 internet: ok" || echo "ipv4 internet: NG(lab host-fix を参照)"
ping -6 -c1 -W2 2001:4860:4860::8888 >/dev/null 2>&1 && echo "ipv6 internet: ok" || echo "ipv6 internet: NG"
EOF
  in_vm "$SHARE/lab/netns.sh" status
}

# lab host-fix:Incus の VM が IPv4 で外に出られるよう、ホストの firewalld と Docker を設定する
cmd_host_fix() {
  local cmds=(
    "firewall-cmd --zone=trusted --change-interface=incusbr0 --permanent"
    "firewall-cmd --reload"
    "iptables -C DOCKER-USER -i incusbr0 -j ACCEPT 2>/dev/null || iptables -I DOCKER-USER -i incusbr0 -j ACCEPT"
    "iptables -C DOCKER-USER -o incusbr0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -I DOCKER-USER -o incusbr0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"
  )
  echo "次を sudo で実行する(DOCKER-USER の 2 行はホストの再起動で消える):"
  printf '  %s\n' "${cmds[@]}"
  read -r -p "実行する? [y/N] " ans
  [[ $ans == [yY] ]] || die "中止"
  for c in "${cmds[@]}"; do sudo bash -c "$c"; done
}

usage() {
  cat <<EOF
usage: lab <command>

  up                  VM を作成・起動し、パッケージ導入、スナップショット作成、netns のトポロジを立てる(冪等)
  reset               スナップショットに戻し、トポロジを立て直す
  destroy [--yes]     VM を削除する
  status              VM、共有、ネットワーク、トポロジの状態
  net up|down|status  netns のトポロジだけを操作する
  exec <ns|vm> <cmd>  VM 内(ns 指定ならその netns 内)でコマンドを実行する。作業ディレクトリは $SHARE
  shell [ns|vm]       VM 内(ns 指定ならその netns 内)で bash を開く
  build               ホストで ./cmd/... ./tools/... を静的ビルドして bin/ に置き、VM の /usr/local/bin に install する
  test <pkg> [ns]     build tag lab 付きでテストバイナリを作り、VM の ns(既定 vps)で実行する
  suite [--vms N] [--netstack default|wgstack|both] [--agent-impl go|rust|both] [--durations FILE] [--parallel N] [--shard-timeout SEC] [--out DIR] [--keep]
                      一時 VM を N 台 (既定 3) 立てて一式を shard に分けて同時に流し、1 つの判定にまとめて VM を消す。
                      組 (agent の実装と netstack) ごとに N 台。結果は <out>/<実装>/<netstack>/
  suite-gc            持ち主のいない一時 VM(lab suite と lab paired が残したもの)を消す
  $PAIRED_SYNOPSIS
                      一時 VM を 2 台立て、2 つの腕 (gvisor、wgstack、rust か base:<それ>) の byte あたりの CPU を
                      同時に流して round ごとに VM を入れ替えて比べ、VM を消す。固定は WGFT_LAB_PAIR_CPUS="<集合 a> <集合 b>"
  host-fix            ホストの firewalld / Docker を設定して VM の IPv4 を通す(sudo)

ns: ${NAMESPACES[*]}
env: WGFT_LAB_VM=$VM WGFT_LAB_IMAGE=$IMAGE WGFT_LAB_CPU=$CPU WGFT_LAB_MEM=$MEM WGFT_LAB_CPUS=${CPUS:-<unset: not pinned>}
     WGFT_LAB_AGENT_IMPL=${WGFT_LAB_AGENT_IMPL:-<unset: go>} (go or rust: the userspace-mode agent the checks run)
     WGFT_LAB_RUST_TARGET=${WGFT_LAB_RUST_TARGET:-<unset: x86_64-unknown-linux-musl>} (the target of the Rust wgft)
EOF
}

sub=${1:-}; shift || true
case "$sub" in
  up) cmd_up ;;
  reset) cmd_reset ;;
  destroy) cmd_destroy "$@" ;;
  status) cmd_status ;;
  net) cmd_net "$@" ;;
  exec) cmd_exec "$@" ;;
  shell) cmd_shell "$@" ;;
  build) cmd_build ;;
  test) cmd_test "$@" ;;
  suite) cmd_suite "$@" ;;
  suite-gc) cmd_suite_gc ;;
  paired) cmd_paired "$@" ;;
  host-fix) cmd_host_fix ;;
  "" | -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
