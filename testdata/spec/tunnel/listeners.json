{
  "comment": "Which listeners a userspace agent opens on its tunnel address for the rules of a full state, and the effective target of each. A listener is proto/port; port p of listen_port lo-hi forwards to the target port plus p - lo. Rules with enabled false open nothing. A port whose effective target port would exceed 65535, and a rule whose target cannot be read as an IPv4 host:port, open nothing. The listeners are sorted by proto, then port.",
  "cases": [
    {
      "name": "one TCP port",
      "rules": [{"id": "mc", "proto": "tcp", "listen_port": "25565", "target": "192.168.1.10:25565", "enabled": true}],
      "listeners": [{"proto": "tcp", "port": 25565, "target": "192.168.1.10:25565", "rule": "mc"}]
    },
    {
      "name": "UDP range mapped onto a shifted target range",
      "rules": [{"id": "vh", "proto": "udp", "listen_port": "2456-2458", "target": "192.168.1.20:3456", "enabled": true}],
      "listeners": [
        {"proto": "udp", "port": 2456, "target": "192.168.1.20:3456", "rule": "vh"},
        {"proto": "udp", "port": 2457, "target": "192.168.1.20:3457", "rule": "vh"},
        {"proto": "udp", "port": 2458, "target": "192.168.1.20:3458", "rule": "vh"}
      ]
    },
    {
      "name": "same port for TCP and UDP and a host name target",
      "rules": [
        {"id": "a", "proto": "udp", "listen_port": "8080", "target": "nas.lan:80", "enabled": true},
        {"id": "b", "proto": "tcp", "listen_port": "8080", "target": "nas.lan:80", "enabled": true}
      ],
      "listeners": [
        {"proto": "tcp", "port": 8080, "target": "nas.lan:80", "rule": "b"},
        {"proto": "udp", "port": 8080, "target": "nas.lan:80", "rule": "a"}
      ]
    },
    {
      "name": "disabled rule opens nothing",
      "rules": [
        {"id": "off", "proto": "tcp", "listen_port": "22", "target": "192.168.1.10:22", "enabled": false},
        {"id": "on", "proto": "tcp", "listen_port": "443", "target": "127.0.0.1:8443", "enabled": true}
      ],
      "listeners": [{"proto": "tcp", "port": 443, "target": "127.0.0.1:8443", "rule": "on"}]
    },
    {
      "name": "ports whose effective target port exceeds 65535 open nothing",
      "rules": [{"id": "top", "proto": "udp", "listen_port": "60000-60003", "target": "192.168.1.30:65534", "enabled": true}],
      "listeners": [
        {"proto": "udp", "port": 60000, "target": "192.168.1.30:65534", "rule": "top"},
        {"proto": "udp", "port": 60001, "target": "192.168.1.30:65535", "rule": "top"}
      ]
    },
    {
      "name": "IPv6 literal target opens nothing",
      "rules": [{"id": "v6", "proto": "tcp", "listen_port": "2222", "target": "[fd00::10]:22", "enabled": true}],
      "listeners": []
    }
  ]
}
